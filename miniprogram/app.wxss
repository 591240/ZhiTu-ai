/* app.wxss —— 全局设计系统（高级感升级版） */

page {
  /* === 核心品牌色 === */
  --primary: #3B82F6;
  --primary-deep: #2563EB;
  --primary-light: #DBEAFE;
  --primary-lighter: #EFF6FF;

  /* 高级渐变 */
  --grad-blue: linear-gradient(135deg, #667EEA 0%, #764BA2 100%);
  --grad-sky: linear-gradient(135deg, #60A5FA 0%, #3B82F6 100%);
  --grad-ocean: linear-gradient(135deg, #4FACFE 0%, #00F2FE 100%);
  --grad-sunset: linear-gradient(135deg, #FA709A 0%, #FEE140 100%);
  --grad-forest: linear-gradient(135deg, #43E97B 0%, #38F9D7 100%);
  --grad-dusk: linear-gradient(135deg, #30CFD0 0%, #330867 100%);

  /* 渐变别名（detail / navig 等复用，避免未定义变量导致背景失效） */
  --gradient-start: #60A5FA;
  --gradient-end: #3B82F6;

  /* 功能色 */
  --gold-start: #D4A951;
  --gold-end: #B8923D;
  --bg-amber: #FFF7E6;
  --amber-text: #8A5A00;
  --amber-border: #FFE0B2;
  --wechat-green: #07C160;
  --purple: #722ED1;
  --danger: #FF4D4F;
  --danger-light: #FEE2E2;
  --orange: #FF6B35;
  --ok-green: #52C41A;

  /* 中性色（更通透） */
  --bg: #F7F8FC;
  --card: #FFFFFF;
  --card-soft: #F8FAFF;
  --text-1: #111827;
  --text-2: #374151;
  --text-3: #6B7280;
  --text-4: #9CA3AF;
  --border: #E5E7EB;
  --line: #F3F4F6;
  --divider: rgba(0, 0, 0, 0.06);

  /* 阴影层级 */
  --shadow-sm: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 4rpx 20rpx rgba(0, 0, 0, 0.06);
  --shadow-lg: 0 12rpx 40rpx rgba(0, 0, 0, 0.10);
  --shadow-blue: 0 8rpx 24rpx rgba(59, 130, 246, 0.16);

  /* 圆角 */
  --r-sm: 12rpx;
  --r-md: 20rpx;
  --r-lg: 32rpx;
  --r-xl: 40rpx;
  --r-full: 999rpx;

  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  line-height: 1.5;
}

view, text, scroll-view, button, input, textarea, image { box-sizing: border-box; }

/* === 布局工具类 === */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.ml-auto { margin-left: auto; }

/* === 卡片（高级感） === */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.9);
}
.card-flat {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
}

/* === 按钮（高级感） === */
.btn-primary {
  background: var(--grad-sky);
  color: #fff;
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  box-shadow: var(--shadow-blue);
  transition: all 0.2s ease;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.92; transform: scale(0.98); }

.btn-green {
  background: var(--wechat-green);
  color: #fff;
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.2);
  transition: all 0.2s ease;
}
.btn-green::after { border: none; }
.btn-green:active { opacity: 0.92; transform: scale(0.98); }

.btn-ghost {
  background: var(--primary-lighter);
  color: var(--primary);
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  transition: all 0.2s ease;
}
.btn-ghost::after { border: none; }
.btn-ghost:active { opacity: 0.85; transform: scale(0.98); }

/* === 标签 === */
.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: var(--r-full);
}
.tag-popular { background: var(--primary-light); color: var(--primary); }
.tag-niche { background: rgba(114, 46, 209, 0.12); color: var(--purple); }

/* === 文本层级 === */
.t-title { font-size: 44rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.5rpx; }
.t-title-md { font-size: 36rpx; font-weight: 700; color: var(--text-1); }
.t-sub { font-size: 28rpx; color: var(--text-2); }
.t-weak { font-size: 24rpx; color: var(--text-3); }
.t-caption { font-size: 22rpx; color: var(--text-4); }

/* === 安全区 === */
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }

/* === 空状态（全局） === */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  color: var(--text-3);
}
.empty .emoji { font-size: 96rpx; margin-bottom: 24rpx; }

/* === 交互反馈 === */
.tap-scale:active {
  transform: scale(0.98);
  transition: transform 0.15s ease-out;
}

/* === 通用输入框 === */
.input-primary {
  background: var(--card-soft);
  border-radius: var(--r-md);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-1);
  border: 1rpx solid var(--border);
  transition: border-color 0.2s ease;
}
.input-primary:focus { border-color: var(--primary); }

/* === 页头（子页面统一高级感） === */
.page-header {
  position: relative;
  border-radius: var(--r-lg);
  padding: 40rpx 36rpx 44rpx;
  margin-bottom: 28rpx;
  overflow: hidden;
  background: var(--grad-sky);
  color: #fff;
  box-shadow: var(--shadow-blue);
}
.page-header.dusk { background: var(--grad-dusk); box-shadow: 0 12rpx 40rpx rgba(48, 207, 208, 0.28); }
.page-header.ocean { background: var(--grad-ocean); box-shadow: 0 12rpx 40rpx rgba(79, 172, 254, 0.3); }
.page-header.sunset { background: var(--grad-sunset); box-shadow: 0 12rpx 40rpx rgba(250, 112, 154, 0.3); }
.ph-badge {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #E0E7FF;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  padding: 10rpx 20rpx;
  border-radius: var(--r-full);
  backdrop-filter: blur(4px);
  margin-bottom: 18rpx;
}
.ph-badge::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7CF0C8;
  margin-right: 10rpx;
  box-shadow: 0 0 12rpx #7CF0C8;
}
.ph-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
}
.ph-sub {
  font-size: 26rpx;
  opacity: 0.9;
  margin-top: 12rpx;
}
.ph-decor {
  position: absolute;
  right: -60rpx;
  bottom: -70rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 70%);
  pointer-events: none;
}

/* === 玻璃卡（高级感统一卡片） === */
.glass {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}

/* === 分段控件（统一胶囊） === */
.seg-pill {
  display: flex;
  gap: 12rpx;
}
.seg-pill .seg-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 0;
  border-radius: var(--r-md);
  background: var(--card-soft);
  font-size: 26rpx;
  color: var(--text-2);
  border: 1rpx solid var(--border);
  transition: all 0.2s ease;
}
.seg-pill .seg-item:active { transform: scale(0.96); }
.seg-pill .seg-item.on {
  background: var(--grad-sky);
  color: #fff;
  font-weight: 600;
  border-color: transparent;
  box-shadow: var(--shadow-blue);
}

/* === 统一分段 chip === */
.chip-pill {
  padding: 14rpx 28rpx;
  border-radius: var(--r-full);
  background: var(--card-soft);
  font-size: 26rpx;
  color: var(--text-2);
  border: 1rpx solid var(--border);
  transition: all 0.2s ease;
}
.chip-pill:active { transform: scale(0.96); }
.chip-pill.on {
  background: var(--primary-lighter);
  color: var(--primary);
  font-weight: 600;
  border-color: var(--primary);
}

/* === 字段标签（带色点） === */
.f-label {
  display: flex;
  align-items: center;
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  margin-bottom: 16rpx;
}
.f-label::before {
  content: '';
  width: 10rpx;
  height: 10rpx;
  border-radius: 50%;
  background: var(--primary);
  margin-right: 14rpx;
  box-shadow: 0 0 8rpx rgba(59, 130, 246, 0.5);
}

/* === 入场动画 === */
.anim-up { animation: fadeUp 0.5s ease-out both; }
.anim-up.d1 { animation-delay: 0.06s; }
.anim-up.d2 { animation-delay: 0.12s; }
.anim-up.d3 { animation-delay: 0.18s; }
.anim-up.d4 { animation-delay: 0.24s; }
.anim-up.d5 { animation-delay: 0.30s; }

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes popIn {
  from { opacity: 0; transform: scale(0.78); }
  to { opacity: 1; transform: scale(1); }
}

@media (prefers-reduced-motion: reduce) {
  .anim-up, .hero, .grid, .service-grid, .tpl-scroll { animation: none !important; }
}
