/* app.wxss —— iOS 26 Liquid Glass 全局设计系统 */

page {
  /* === iOS 系统语义色 === */
  --ios-blue: #0A84FF;
  --ios-blue-deep: #0066D6;
  --ios-green: #34C759;
  --ios-orange: #FF9F0A;
  --ios-red: #FF453A;
  --ios-purple: #BF5AF2;
  --ios-teal: #64D2FF;
  --ios-indigo: #5E5CE6;
  --ios-pink: #FF375F;
  --ios-yellow: #FFD60A;

  /* 渐变别名（兼容各页面历史引用，统一为 iOS 蓝/橙体系） */
  --gradient-start: #64D2FF;
  --gradient-end: #0A84FF;
  --grad-blue: linear-gradient(135deg, #5E5CE6 0%, #0A84FF 100%);
  --grad-sky: linear-gradient(135deg, #64D2FF 0%, #0A84FF 100%);
  --grad-ocean: linear-gradient(135deg, #5AC8FA 0%, #007AFF 100%);
  --grad-sunset: linear-gradient(135deg, #FF9F0A 0%, #FF375F 100%);
  --grad-forest: linear-gradient(135deg, #30D158 0%, #00C7BE 100%);
  --grad-dusk: linear-gradient(135deg, #7D7AFF 0%, #5E5CE6 100%);

  /* === 主品牌色（iOS 蓝，最"苹果"） === */
  --primary: #0A84FF;
  --primary-deep: #0066D6;
  --primary-light: rgba(10, 132, 255, 0.14);
  --primary-lighter: rgba(10, 132, 255, 0.10);

  /* 暖金（会员/权益点缀，保留一点暖） */
  --gold-start: #D4A951;
  --gold-end: #B8923D;
  --bg-amber: #FFF7E6;
  --amber-text: #8A5A00;
  --amber-border: #FFE0B2;

  --wechat-green: #07C160;
  --purple: #BF5AF2;
  --danger: #FF3B30;
  --danger-light: #FFE5E3;
  --orange: #FF9F0A;
  --ok-green: #34C759;

  /* === 背景 / 卡片（玻璃体系） === */
  --bg: #F2F2F7;          /* iOS 系统灰 */
  --bg-grouped: #F2F2F7;
  --card: rgba(255, 255, 255, 0.66);          /* 玻璃卡（半透明白） */
  --card-solid: #FFFFFF;                       /* 不透明卡 */
  --card-soft: rgba(118, 118, 128, 0.10);      /* iOS 二级填充 */
  --fill: rgba(118, 118, 128, 0.12);
  --fill-2: rgba(118, 118, 128, 0.08);

  /* === 文字灰阶（iOS label 体系） === */
  --text-1: #1C1C1E;
  --text-2: #3A3A3C;
  --text-3: #8E8E93;
  --text-4: #C7C7CC;

  /* === 分隔线 === */
  --border: rgba(60, 60, 67, 0.16);
  --line: rgba(60, 60, 67, 0.10);
  --divider: rgba(60, 60, 67, 0.12);
  --separator: rgba(60, 60, 67, 0.12);

  /* === 阴影层级（更轻盈） === */
  --shadow-sm: 0 1rpx 3rpx rgba(0, 0, 0, 0.04);
  --shadow-md: 0 6rpx 22rpx rgba(0, 0, 0, 0.07);
  --shadow-lg: 0 16rpx 44rpx rgba(0, 0, 0, 0.12);
  --shadow-blue: 0 10rpx 28rpx rgba(10, 132, 255, 0.28);

  /* === 圆角 === */
  --r-sm: 10rpx;
  --r-md: 16rpx;
  --r-lg: 20rpx;
  --r-xl: 28rpx;
  --r-xxl: 34rpx;
  --r-full: 999rpx;

  background: var(--bg);
  color: var(--text-1);
  font-size: 28rpx;
  font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "PingFang SC", "Noto Sans SC", "Helvetica Neue", sans-serif;
  line-height: 1.5;
  letter-spacing: -0.2rpx;
}

view, text, scroll-view, button, input, textarea, image { box-sizing: border-box; }

/* === 布局工具 === */
.flex { display: flex; }
.flex-col { display: flex; flex-direction: column; }
.flex-center { display: flex; align-items: center; justify-content: center; }
.flex-between { display: flex; align-items: center; justify-content: space-between; }
.flex-1 { flex: 1; }
.ml-auto { margin-left: auto; }

/* === Liquid Glass 材质（核心） ===
   小程序 backdrop-filter 在 iOS 真机支持良好，Android 部分支持；
   rgba 半透明已作兜底，不支持时呈现半透明白卡片，视觉仍统一 */
.glass {
  background: rgba(255, 255, 255, 0.62);
  backdrop-filter: blur(26px) saturate(190%);
  -webkit-backdrop-filter: blur(26px) saturate(190%);
  border: 0.5px solid rgba(255, 255, 255, 0.5);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.08), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.6);
}
.glass-strong {
  background: rgba(255, 255, 255, 0.82);
  backdrop-filter: blur(30px) saturate(200%);
  -webkit-backdrop-filter: blur(30px) saturate(200%);
  border: 0.5px solid rgba(255, 255, 255, 0.55);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.10), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.7);
}
/* 深色背景（如首页全屏图）之上的玻璃 */
.glass-dark {
  background: rgba(255, 255, 255, 0.18);
  backdrop-filter: blur(28px) saturate(200%);
  -webkit-backdrop-filter: blur(28px) saturate(200%);
  border: 0.5px solid rgba(255, 255, 255, 0.38);
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.22), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.5);
}

/* === 卡片（玻璃升级） === */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 32rpx;
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 0.5px solid rgba(255, 255, 255, 0.45);
  box-shadow: var(--shadow-md), inset 0 1rpx 1rpx rgba(255, 255, 255, 0.5);
}
.card-flat {
  background: var(--card-solid);
  border-radius: var(--r-lg);
  padding: 32rpx;
  box-shadow: var(--shadow-sm);
  border: 0.5px solid var(--line);
}

/* === 按钮（iOS 蓝主色 + 胶囊） === */
.btn-primary {
  background: var(--primary);
  color: #fff;
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  box-shadow: var(--shadow-blue);
  transition: all 0.2s ease;
}
.btn-primary::after { border: none; }
.btn-primary:active { opacity: 0.92; transform: scale(0.98); }

.btn-green {
  background: var(--wechat-green);
  color: #fff;
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.22);
  transition: all 0.2s ease;
}
.btn-green::after { border: none; }
.btn-green:active { opacity: 0.92; transform: scale(0.98); }

.btn-ghost {
  background: var(--fill);
  color: var(--primary);
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 600;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  transition: all 0.2s ease;
}
.btn-ghost::after { border: none; }
.btn-ghost:active { opacity: 0.85; transform: scale(0.98); }

.btn-gold {
  background: linear-gradient(135deg, var(--gold-start), var(--gold-end));
  color: #fff;
  border-radius: var(--r-full);
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  padding: 24rpx 0;
  border: none;
  box-shadow: 0 8rpx 22rpx rgba(184, 146, 61, 0.3);
  transition: all 0.2s ease;
}
.btn-gold::after { border: none; }
.btn-gold:active { opacity: 0.92; transform: scale(0.98); }

/* === 标签 === */
.tag {
  display: inline-block;
  font-size: 22rpx;
  font-weight: 600;
  padding: 8rpx 20rpx;
  border-radius: var(--r-full);
}
.tag-popular { background: rgba(255, 159, 10, 0.16); color: #B26A00; }
.tag-niche { background: rgba(191, 90, 242, 0.14); color: #8E3FCF; }
.tag-blue { background: rgba(10, 132, 255, 0.14); color: var(--ios-blue-deep); }

/* === 文本层级 === */
.t-title { font-size: 44rpx; font-weight: 700; color: var(--text-1); letter-spacing: -1rpx; }
.t-title-md { font-size: 36rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.5rpx; }
.t-sub { font-size: 28rpx; color: var(--text-2); }
.t-weak { font-size: 24rpx; color: var(--text-3); }
.t-caption { font-size: 22rpx; color: var(--text-4); }

/* === 安全区 === */
.safe-bottom { padding-bottom: calc(env(safe-area-inset-bottom) + 24rpx); }

/* === 空状态 === */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 160rpx 40rpx;
  color: var(--text-3);
}
.empty .emoji { font-size: 96rpx; margin-bottom: 24rpx; }

/* === 交互反馈 === */
.tap-scale:active { transform: scale(0.98); transition: transform 0.15s ease-out; }

/* === 通用输入框（玻璃） === */
.input-primary {
  background: var(--fill);
  border-radius: var(--r-md);
  padding: 24rpx 28rpx;
  font-size: 28rpx;
  color: var(--text-1);
  border: 0.5px solid var(--line);
  transition: border-color 0.2s ease;
}
.input-primary:focus { border-color: var(--primary); }

/* === 分段控件（iOS 胶囊） === */
.seg-pill { display: flex; gap: 12rpx; }
.seg-pill .seg-item {
  flex: 1; text-align: center; padding: 18rpx 0;
  border-radius: var(--r-md); background: var(--fill);
  font-size: 26rpx; color: var(--text-2);
  border: none; transition: all 0.2s ease;
}
.seg-pill .seg-item:active { transform: scale(0.96); }
.seg-pill .seg-item.on {
  background: var(--card-solid); font-weight: 600; color: var(--text-1);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.10);
}

/* === 统一 chip === */
.chip-pill {
  padding: 14rpx 28rpx; border-radius: var(--r-full);
  background: var(--fill); font-size: 26rpx; color: var(--text-2);
  transition: all 0.2s ease;
}
.chip-pill:active { transform: scale(0.96); }
.chip-pill.on { background: var(--primary-light); color: var(--primary-deep); font-weight: 600; }

/* === 下划线 Tab === */
.tabs-underline { display: flex; border-bottom: 0.5px solid var(--border); }
.tabs-underline .tb {
  position: relative; padding: 24rpx 4rpx; margin-right: 44rpx;
  font-size: 28rpx; color: var(--text-3); transition: color 0.2s ease;
}
.tabs-underline .tb.on { color: var(--text-1); font-weight: 700; }
.tabs-underline .tb.on::after {
  content: ''; position: absolute; left: 0; right: 0; bottom: -1rpx;
  height: 3rpx; border-radius: var(--r-full); background: var(--primary);
}

/* === 字段标签（带色点） === */
.f-label { display: flex; align-items: center; font-size: 28rpx; font-weight: 700; color: var(--text-1); margin-bottom: 16rpx; }
.f-label::before { content: ''; width: 10rpx; height: 10rpx; border-radius: 50%; background: var(--primary); margin-right: 14rpx; }

/* === 页头（子页面统一玻璃头） === */
.page-header {
  position: relative; border-radius: var(--r-lg);
  padding: 40rpx 36rpx 44rpx; margin-bottom: 28rpx;
  background: var(--card); color: var(--text-1);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 0.5px solid rgba(255, 255, 255, 0.45);
  box-shadow: var(--shadow-sm);
}
.ph-badge {
  display: inline-flex; align-items: center; font-size: 22rpx; font-weight: 600;
  color: var(--primary-deep); background: var(--primary-light);
  padding: 10rpx 20rpx; border-radius: var(--r-full); margin-bottom: 18rpx;
}
.ph-badge::before { content: ''; width: 12rpx; height: 12rpx; border-radius: 50%; background: var(--primary); margin-right: 10rpx; }
.ph-title { font-size: 44rpx; font-weight: 800; letter-spacing: -1rpx; }
.ph-sub { font-size: 26rpx; color: var(--text-3); margin-top: 12rpx; }

/* === 入场动画 === */
.anim-up { animation: fadeUp 0.5s ease-out both; }
.anim-up.d1 { animation-delay: 0.06s; }
.anim-up.d2 { animation-delay: 0.12s; }
.anim-up.d3 { animation-delay: 0.18s; }
.anim-up.d4 { animation-delay: 0.24s; }
.anim-up.d5 { animation-delay: 0.30s; }

@keyframes fadeUp { from { opacity: 0; transform: translateY(28rpx); } to { opacity: 1; transform: translateY(0); } }
@keyframes fadeIn { from { opacity: 0; } to { opacity: 1; } }
@keyframes popIn { from { opacity: 0; transform: scale(0.78); } to { opacity: 1; transform: scale(1); } }

@media (prefers-reduced-motion: reduce) {
  .anim-up { animation: none !important; }
}
