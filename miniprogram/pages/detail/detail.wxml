<wxs module="m">
function slotLabel(v){ var map={'morning':'上午','afternoon':'下午','evening':'晚上'}; return map[v]||v; }
function mealLabel(v){ var map={'breakfast':'早餐','lunch':'午餐','dinner':'晚餐'}; return map[v]||v; }
function idx(arr, v){ for(var i=0;i<arr.length;i++){ if(arr[i]===v) return i; } return 0; }
module.exports = { slotLabel: slotLabel, mealLabel: mealLabel, idx: idx };
</wxs>

<view class="page" wx:if="{{trip}}">
  <!-- 全屏城市背景图（方案C：大图背景 + 半透明卡片） -->
  <image class="bg-fixed" src="{{headImage}}" mode="aspectFill" binderror="onHeadError" />
  <view class="bg-overlay"></view>

  <view class="d-head">
    <image class="d-head-bg" src="{{headImage}}" mode="aspectFill" binderror="onHeadError" />
    <view class="d-head-mask"></view>
    <view class="d-title">{{trip.title}}</view>
    <view class="d-sub">{{trip.city}} · {{trip.days}}天 · <route-tag type="{{trip.route_type}}" /></view>
    <view wx:if="{{!editing}}" class="edit-entry" bindtap="enterEdit">✏️ 编辑</view>
  </view>

  <!-- 行前准备（跨境/特殊证件提醒：签证、港澳通行证、电话卡等） -->
  <view wx:if="{{trip.content.preparations.length}}" class="prep card">
    <view class="prep-head">
      <text class="prep-ico">🛂</text>
      <text class="prep-title">行前准备</text>
      <text class="prep-sub">出发前请提前备齐</text>
    </view>
    <view wx:for="{{trip.content.preparations}}" wx:key="title" class="prep-item">
      <text class="prep-item-ico">{{item.icon}}</text>
      <view class="prep-item-body">
        <text class="prep-item-title">{{item.title}}</text>
        <text class="prep-item-detail">{{item.detail}}</text>
      </view>
    </view>
  </view>

  <!-- 往返交通方案（仅展示态） -->
  <view wx:if="{{!editing && trip.content.transport_plans.length}}" class="tp-wrap">
    <view class="block-title row"><text>🚄 往返交通方案</text><text class="mini-link" bindtap="goTicket">查实时余票 ›</text></view>
    <view class="seg wrap">
      <view wx:for="{{trip.content.transport_plans}}" wx:key="name"
            class="chip {{transportIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="setTransport">{{item.name}}</view>
    </view>
    <view wx:if="{{trip.content.transport_plans[transportIndex]}}" class="tp-card card">
      <view class="tp-row"><text class="tp-k">方式</text><text class="tp-v">{{trip.content.transport_plans[transportIndex].mode}}</text></view>
      <view class="tp-row"><text class="tp-k">价格</text><text class="tp-v">¥{{trip.content.transport_plans[transportIndex].price}}</text></view>
      <view class="tp-row"><text class="tp-k">时长</text><text class="tp-v">{{trip.content.transport_plans[transportIndex].duration}}</text></view>
      <view class="tp-pros">✅ {{trip.content.transport_plans[transportIndex].pros}}</view>
      <view class="tp-cons">⚠️ {{trip.content.transport_plans[transportIndex].cons}}</view>
      <view class="tp-note">📌 {{trip.content.transport_plans[transportIndex].arrival_note}}</view>
    </view>
  </view>

  <scroll-view scroll-x class="day-tabs" enhanced show-scrollbar="{{false}}">
    <view wx:for="{{trip.content.itinerary}}" wx:key="day_number"
          class="day-tab {{dayIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="setDay">
      第{{item.day_number}}天
    </view>
  </scroll-view>

  <block wx:if="{{currentDay}}">
    <!-- 每日环境提示 -->
    <view wx:if="{{currentDay.weather_tip || currentDay.season_tip || currentDay.crowd_tip || editing}}" class="day-tips">
      <block wx:if="{{editing}}">
        <input class="tip-input" placeholder="天气提示" value="{{currentDay.weather_tip}}" data-di="{{dayIndex}}" data-field="weather_tip" bindinput="editDayField" />
        <input class="tip-input" placeholder="季节提示" value="{{currentDay.season_tip}}" data-di="{{dayIndex}}" data-field="season_tip" bindinput="editDayField" />
        <input class="tip-input" placeholder="人流提示" value="{{currentDay.crowd_tip}}" data-di="{{dayIndex}}" data-field="crowd_tip" bindinput="editDayField" />
      </block>
      <block wx:else>
        <view wx:if="{{currentDay.weather_tip}}" class="dt weather">🌤 {{currentDay.weather_tip}}</view>
        <view wx:if="{{currentDay.season_tip}}" class="dt season">📅 {{currentDay.season_tip}}</view>
        <view wx:if="{{currentDay.crowd_tip}}" class="dt crowd">👥 {{currentDay.crowd_tip}}</view>
      </block>
    </view>

    <!-- 时间轴（展示态） -->
    <block wx:if="{{!editing}}">
      <view class="block-title">🗓 当日行程
        <text class="mini-link" bindtap="goNavigate">导航 ›</text>
      </view>
      <view class="timeline">
        <block wx:for="{{timeline}}" wx:key="tid" wx:for-index="ti">
          <view wx:if="{{item.type === 'transport'}}" class="tl-trans">
            <view class="tl-time"></view>
            <view class="tl-axis"><view class="tl-dot sm"></view></view>
            <view class="tl-trans-card">
              <view class="tl-trans-main">{{(item.mode === '公交' || item.mode === 'subway' || item.mode === 'bus') ? '🚌' : (item.mode === '步行' ? '🚶' : '🚗')}} {{item.from}} → {{item.to}} · 约{{item.duration_min}}分钟 · ¥{{item.cost}}</view>
              <view wx:if="{{item.detail}}" class="tl-trans-detail">{{item.detail}}</view>
              <view wx:if="{{item.segments && item.segments.length}}" class="tl-trans-segs">
                <view wx:for="{{item.segments}}" wx:for-item="seg" wx:key="index" class="tl-trans-seg {{seg.type}}">
                  <text wx:if="{{seg.type === 'walking'}}">🚶 {{seg.instruction}} · {{seg.duration_min}}分钟</text>
                  <text wx:elif="{{seg.type === 'bus' || seg.type === 'subway'}}">🚌 {{seg.line}}：{{seg.from_stop}} → {{seg.to_stop}}（{{seg.stations}}站）</text>
                </view>
              </view>
            </view>
          </view>
          <view wx:else class="tl-node">
            <view class="tl-time">{{item.time}}</view>
            <view class="tl-axis"><view class="tl-dot"></view></view>
            <view class="tl-card">
              <block wx:if="{{item.type === 'spot'}}">
                <view class="sp-media" wx:if="{{item.data.image && !item.data._imgError}}">
                  <image class="sp-img" src="{{item.data.image}}" mode="aspectFill" lazy-load="{{true}}" data-ti="{{ti}}" binderror="onImgError" />
                  <view class="sp-media-mask"></view>
                  <text wx:if="{{item.data.category}}" class="sp-cat-over">{{item.data.category}}</text>
                  <text class="sp-price-over {{((item.data.best_price || item.data.ticket_price) === 0) ? 'free' : ''}}">{{(item.data.best_price || item.data.ticket_price) === 0 ? '免费' : ('¥' + (item.data.best_price || item.data.ticket_price))}}</text>
                </view>
                <view wx:else class="sp-media sp-media-empty">
                  <text class="sp-emoji">{{item.data.category === '人文历史' ? '🏯' : (item.data.category === '自然风光' ? '🌄' : (item.data.category === '美食' ? '🍜' : '📍'))}}</text>
                  <text wx:if="{{item.data.category}}" class="sp-cat-over">{{item.data.category}}</text>
                  <text class="sp-price-over {{((item.data.best_price || item.data.ticket_price) === 0) ? 'free' : ''}}">{{(item.data.best_price || item.data.ticket_price) === 0 ? '免费' : ('¥' + (item.data.best_price || item.data.ticket_price))}}</text>
                </view>
                <view class="sp-body">
                  <view class="sp-head">
                    <text class="sp-slot">{{item.data.time_slot === 'morning' ? '上午' : (item.data.time_slot === 'afternoon' ? '下午' : '晚上')}}</text>
                    <text class="sp-name">{{item.data.name}}</text>
                  </view>
                  <view class="sp-addr">📍 {{item.data.address}}</view>
                  <view class="sp-desc">{{item.data.description}}</view>
                  <view class="sp-foot">
                    <text class="sp-meta">⏱ {{item.data.duration_min}}分钟</text>
                    <text class="sp-act media" bindtap="onSpotMedia" data-name="{{item.data.name}}">视频/攻略 ›</text>
                  </view>

                  <!-- 拍照攻略 + 美食攻略 双栏 -->
                  <view wx:if="{{item.data.firstPhotoSpot || item.data.firstNearMeal}}" class="guide-card">
                    <view wx:if="{{item.data.firstPhotoSpot}}" class="guide-col guide-photo">
                      <view class="gc-title">📸 拍照攻略</view>
                      <view class="gc-item">
                        <view class="gc-head">
                          <text class="gc-pos">{{item.data.firstPhotoSpot.position}}</text>
                          <text class="gc-tag">{{item.data.firstPhotoSpot.best_time}}</text>
                        </view>
                        <view class="gc-body">{{item.data.firstPhotoSpot.tip}}</view>
                        <view wx:if="{{item.data.firstPhotoSpot.avoid_crowd || item.data.firstPhotoSpot.day_night || item.data.firstPhotoSpot.suitable_for}}" class="gc-foot">
                          <text wx:if="{{item.data.firstPhotoSpot.avoid_crowd}}" class="gc-pill">避峰：{{item.data.firstPhotoSpot.avoid_crowd}}</text>
                          <text wx:if="{{item.data.firstPhotoSpot.day_night}}" class="gc-pill">{{item.data.firstPhotoSpot.day_night}}景</text>
                          <text wx:if="{{item.data.firstPhotoSpot.suitable_for}}" class="gc-pill">适合{{item.data.firstPhotoSpot.suitable_for}}</text>
                        </view>
                      </view>
                    </view>
                    <view wx:if="{{item.data.firstNearMeal}}" class="guide-col guide-food">
                      <view class="gc-title">🍽 美食攻略</view>
                      <view class="gc-item">
                        <view class="gc-head">
                          <text class="gc-pos">{{item.data.firstNearMeal.name}}</text>
                          <text class="gc-tag">{{item.data.firstNearMeal.type === 'breakfast' ? '早餐' : (item.data.firstNearMeal.type === 'dinner' ? '晚餐' : '午餐')}}</text>
                        </view>
                        <view class="gc-body">特色：{{item.data.firstNearMeal.specialty || '当地热门餐厅'}} · 人均 ¥{{item.data.firstNearMeal.avg_price}}</view>
                        <view wx:if="{{item.data.firstNearMeal.deal_channel}}" class="gc-foot">
                          <text class="gc-pill">推荐{{item.data.firstNearMeal.deal_channel}}团购</text>
                        </view>
                      </view>
                    </view>
                  </view>

                  <!-- 公众号预约 + 门票购买 大按钮 -->
                  <view class="spot-bottom-actions">
                    <view wx:if="{{item.data.need_booking}}" class="sba-btn book" data-di="{{dayIndex}}" data-si="{{item._i}}" bindtap="onSpotBooking">
                      <text class="sba-ico">📅</text>
                      <text class="sba-text">公众号预约</text>
                      <text class="sba-note">{{item.data.booking_name || '官方预约'}}</text>
                    </view>
                    <view wx:if="{{item.data.ticket_price > 0}}" class="sba-btn buy {{item.data.ticket_channel ? 'rec' : ''}}" data-di="{{dayIndex}}" data-si="{{item._i}}" bindtap="onSpotTicket">
                      <text class="sba-ico">🎫</text>
                      <text class="sba-text">门票购买</text>
                      <text class="sba-note">{{item.data.ticket_channel ? ('AI推荐 ' + (item.data.best_price || item.data.ticket_price) + '元 · ' + item.data.ticket_channel) : ('约 ¥' + (item.data.best_price || item.data.ticket_price))}}</text>
                    </view>
                  </view>
                </view>
              </block>
              <block wx:else>
                <view class="ml-row">
                  <view class="ml-ico">{{item.data.type === 'breakfast' ? '🥢' : (item.data.type === 'dinner' ? '🍲' : '🍜')}}</view>
                  <view class="ml-body">
                    <view class="ml-top">
                      <text class="ml-name">{{item.data.name}}</text>
                      <text class="ml-type">{{item.data.type === 'breakfast' ? '早餐' : (item.data.type === 'dinner' ? '晚餐' : '午餐')}}</text>
                    </view>
                    <view wx:if="{{item.data.specialty}}" class="ml-special">特色：{{item.data.specialty}}</view>
                    <view class="ml-price">人均 ¥{{item.data.avg_price}}<text wx:if="{{item.data.deal_channel}}" class="ml-deal"> · 推荐{{item.data.deal_channel}}团购</text></view>
                  </view>
                  <text class="sp-act deal {{item.data.deal_channel ? 'rec' : ''}}" data-di="{{dayIndex}}" data-mi="{{item._i}}" bindtap="onMealDeal">
                    <block wx:if="{{item.data.deal_channel}}">去{{item.data.deal_channel}}团购 ›</block>
                    <block wx:else>团购/查低价 ›</block>
                  </text>
                </view>
              </block>
            </view>
          </view>
        </block>
      </view>
    </block>

    <!-- 编辑态：景点 / 餐饮 / 交通 编辑 -->
    <block wx:if="{{editing}}">
    <view class="block-title">📍 景点安排
      <text class="add-mini" data-di="{{dayIndex}}" bindtap="addSpot">+ 添加</text>
    </view>
    <view wx:for="{{currentDay.spots}}" wx:key="name" class="spot card edit-card">
        <view class="ed-row">
          <input class="ed-name" placeholder="景点名" value="{{item.name}}" data-di="{{dayIndex}}" data-si="{{index}}" data-field="name" bindinput="editSpotField" />
          <picker class="ed-picker" range="{{SLOT_LABELS}}" value="{{m.idx(SLOTS, item.time_slot)}}" data-di="{{dayIndex}}" data-si="{{index}}" bindchange="onSpotSlot">
            <view class="ed-picker-v">{{m.slotLabel(item.time_slot)}}</view>
          </picker>
          <view class="ed-del" data-di="{{dayIndex}}" data-si="{{index}}" bindtap="delSpot">✕</view>
        </view>
        <input class="ed-input" placeholder="地址" value="{{item.address}}" data-di="{{dayIndex}}" data-si="{{index}}" data-field="address" bindinput="editSpotField" />
        <view class="ed-row">
          <input class="ed-num" type="number" placeholder="时长(分)" value="{{item.duration_min}}" data-di="{{dayIndex}}" data-si="{{index}}" data-field="duration_min" bindinput="editSpotField" />
          <input class="ed-num" type="number" placeholder="票价" value="{{item.ticket_price}}" data-di="{{dayIndex}}" data-si="{{index}}" data-field="ticket_price" bindinput="editSpotField" />
        </view>
        <input class="ed-input" placeholder="简介" value="{{item.description}}" data-di="{{dayIndex}}" data-si="{{index}}" data-field="description" bindinput="editSpotField" />
    </view>

    <view class="block-title">🍽 餐饮推荐
      <text class="add-mini" data-di="{{dayIndex}}" bindtap="addMeal">+ 添加</text>
    </view>
    <view wx:for="{{currentDay.meals}}" wx:key="name" class="meal card edit-card">
        <view class="ed-row">
          <input class="ed-name" placeholder="餐厅名" value="{{item.name}}" data-di="{{dayIndex}}" data-mi="{{index}}" data-field="name" bindinput="editMealField" />
          <picker class="ed-picker" range="{{MEAL_LABELS}}" value="{{m.idx(MEAL_TYPES, item.type)}}" data-di="{{dayIndex}}" data-mi="{{index}}" bindchange="onMealType">
            <view class="ed-picker-v">{{m.mealLabel(item.type)}}</view>
          </picker>
          <view class="ed-del" data-di="{{dayIndex}}" data-mi="{{index}}" bindtap="delMeal">✕</view>
        </view>
        <view class="ed-row">
          <input class="ed-num" type="number" placeholder="人均" value="{{item.avg_price}}" data-di="{{dayIndex}}" data-mi="{{index}}" data-field="avg_price" bindinput="editMealField" />
          <input class="ed-input flex1" placeholder="招牌菜" value="{{item.specialty}}" data-di="{{dayIndex}}" data-mi="{{index}}" data-field="specialty" bindinput="editMealField" />
        </view>
    </view>

    <view class="block-title">🚌 交通建议</view>
    <view wx:for="{{currentDay.transport}}" wx:key="from" class="trans card">
      {{item.from}} → {{item.to}} · {{item.mode}} · {{item.duration_min}}分钟 · ¥{{item.cost}}
      <view wx:if="{{item.detail}}" class="trans-detail">{{item.detail}}</view>
    </view>
    </block>

    <!-- 预算 + 避坑 -->
    <view class="summary card">
      <view class="sum-row">
        <text>当日预算</text>
        <text class="sum-budget">¥{{currentDay.budget}}</text>
      </view>
      <view class="tips">{{currentDay.tips}}</view>
    </view>
  </block>

  <!-- 总预算分析 -->
  <view wx:if="{{trip.content.budget_analysis}}" class="summary card ba">
    <view class="block-title" style="margin-top:0">💰 总预算分析</view>
    <view class="tips">{{trip.content.budget_analysis}}</view>
  </view>

  <view class="safe-bottom"></view>

  <!-- 底部操作栏 -->
  <view class="action-bar">
    <block wx:if="{{editing}}">
      <button class="btn-ghost act-btn" bindtap="cancelEdit">取消</button>
      <button class="btn-primary act-btn" bindtap="saveEdit">完成</button>
    </block>
    <block wx:else>
      <button class="btn-ghost act-btn" bindtap="onAdjust">对话微调</button>
      <button class="btn-primary act-btn" bindtap="onSave">保存行程</button>
    </block>
  </view>
</view>

<view wx:else class="empty">
  <view class="emoji">🗺️</view>
  <text>未找到行程</text>
</view>
