.page { padding: 24rpx 32rpx; }
.card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.04);
}
.label { font-size: 30rpx; font-weight: bold; color: var(--text-1); margin-bottom: 16rpx; }
.textarea {
  width: 100%;
  height: 240rpx;
  font-size: 28rpx;
  color: var(--text-1);
  line-height: 1.6;
}
.count { text-align: right; font-size: 24rpx; color: var(--text-4); margin-top: 12rpx; }
.input {
  height: 72rpx;
  font-size: 28rpx;
  color: var(--text-1);
  border-bottom: 2rpx solid var(--line);
}
.btn {
  margin-top: 48rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  background: #CBD5E1;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
.btn.active { background: linear-gradient(135deg, #60A5FA, #3B82F6); }
