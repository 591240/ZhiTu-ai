<view class="page">
  <view class="page-header">
    <view class="ph-badge">意见反馈</view>
    <view class="ph-title">意见反馈</view>
    <view class="ph-sub">您的每一条建议，都是我们前进的动力</view>
    <view class="ph-decor"></view>
  </view>

  <view class="card">
    <view class="label">反馈内容</view>
    <textarea class="textarea" placeholder="请描述您遇到的问题或建议…" maxlength="500" value="{{content}}" bindinput="onContent" />
    <view class="count">{{content.length || 0}}/500</view>
  </view>

  <view class="card">
    <view class="label">联系方式（选填）</view>
    <input class="input-primary" placeholder="手机号 / 微信 / 邮箱" value="{{contact}}" bindinput="onContact" />
  </view>

  <view class="submit-row">
    <button class="btn-primary" disabled="{{!content}}" bindtap="submit">提交反馈</button>
  </view>
</view>
