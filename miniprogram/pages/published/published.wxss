/* published.wxss —— 已发布页（统一新视觉：大封面 + 圆角卡片） */
.page { padding: 0 28rpx; min-height: 100vh; background: var(--bg); }
.nav-title { font-size: 40rpx; font-weight: bold; padding: 28rpx 0 20rpx; color: var(--text-1); }

.loading { text-align: center; color: var(--text-3); margin-top: 120rpx; font-size: 28rpx; }

.tpl-list { margin-top: 8rpx; }
.tpl {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: 24rpx;
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 6rpx 20rpx rgba(59, 130, 246, 0.08);
  transition: transform 0.15s ease-out;
}
.tpl:active { transform: scale(0.985); }
.tpl-cover {
  width: 120rpx; height: 120rpx;
  border-radius: 18rpx;
  background: linear-gradient(135deg, var(--primary-light), #93C5FD);
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(59, 130, 246, 0.15);
}
.tpl-info { flex: 1; margin-left: 22rpx; min-width: 0; }
.tpl-title { font-size: 30rpx; font-weight: bold; color: var(--text-1); }
.tpl-meta { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }
.tpl-arrow { font-size: 40rpx; color: var(--text-4); flex-shrink: 0; margin-left: 8rpx; }
