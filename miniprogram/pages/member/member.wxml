<view class="page">
  <!-- 积分余额卡片 -->
  <view class="points-card">
    <view class="points-top">
      <view class="points-name">我的积分</view>
      <view class="points-badge">积分制</view>
    </view>
    <view class="points-num">{{points}}</view>
    <view class="points-desc">每次 AI 生成行程消耗 {{costPerPlan}} 积分，问答消耗 {{costPerChat}} 积分</view>
  </view>

  <!-- 充值套餐 -->
  <view class="sec-title">选择充值套餐</view>
  <view class="plans">
    <view class="plan {{selectedAmount===item.amount?'sel':''}}" wx:for="{{plans}}" wx:key="amount" bindtap="selectPlan" data-amount="{{item.amount}}">
      <view wx:if="{{item.tag}}" class="plan-tag">{{item.tag}}</view>
      <view class="plan-points">{{item.points}}积分</view>
      <view class="plan-price"><text class="cur">¥</text>{{item.amount}}</view>
      <view class="plan-note">{{item.note}}</view>
    </view>
  </view>

  <!-- 收款码 -->
  <view class="sec-title">扫码支付</view>
  <view class="qrcode-card card">
    <view class="qrcode-tip">请使用微信/支付宝扫码支付</view>
    <view class="qrcode-placeholder">
      <view class="qrcode-border">
        <image wx:if="{{!qrcodeError}}" class="qrcode-img" src="/images/pay-qrcode.png" mode="aspectFit" binderror="onQrcodeError" />
        <block wx:else>
          <view class="qrcode-text">收款码</view>
          <view class="qrcode-sub">替换 images/pay-qrcode.png</view>
        </block>
      </view>
    </view>
    <view class="qrcode-amount">应付金额：<text class="amount">¥{{selectedAmount}}</text></view>
    <view class="qrcode-note">支付成功后，请填写下方信息，客服将在 24 小时内为您充值</view>
  </view>

  <!-- 充值信息 -->
  <view class="sec-title">充值确认</view>
  <view class="form card">
    <view class="field">
      <view class="label">充值金额</view>
      <input class="input" type="digit" placeholder="请输入实际支付金额" value="{{amount}}" bindinput="onAmount" />
    </view>
    <view class="field">
      <view class="label">联系方式</view>
      <input class="input" placeholder="请输入微信号或手机号" value="{{contact}}" bindinput="onContact" />
    </view>
    <view class="field">
      <view class="label">备注（选填）</view>
      <input class="input" placeholder="如：支付时间/订单尾号" value="{{note}}" bindinput="onNote" />
    </view>
  </view>

  <button class="btn-primary" bindtap="onSubmit" loading="{{submitting}}">提交充值申请</button>
  <view class="tip">* 充值申请提交后，请添加客服微信并提供支付截图，客服确认后为您加积分</view>
</view>
