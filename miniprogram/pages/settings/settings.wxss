/* settings.wxss —— 设置页（统一新色彩规范） */
.page { padding: 0 32rpx; min-height: 100vh; background: var(--bg); }
.nav-title { font-size: 40rpx; font-weight: bold; padding: 24rpx 0 20rpx; color: var(--text-1); }

.group {
  background: var(--card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(59, 130, 246, 0.08);
  overflow: hidden;
}
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--line);
  transition: background 0.15s;
}
.item:last-child { border-bottom: none; }
.item:active { background: var(--bg); }
.arrow { font-size: 32rpx; color: var(--text-4); }
.val { font-size: 24rpx; color: var(--text-3); }

.danger-group {
  background: var(--card);
  border-radius: 20rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 12rpx rgba(59, 130, 246, 0.08);
  overflow: hidden;
}
.danger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 24rpx;
  font-size: 28rpx;
  color: var(--danger);
  transition: background 0.15s;
}
.danger-item:active { background: var(--danger-light); }

.logout {
  text-align: center;
  padding: 24rpx;
  margin-top: 48rpx;
  font-size: 28rpx;
  color: var(--danger);
  background: var(--card);
  border-radius: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(59, 130, 246, 0.08);
}
.logout:active { background: var(--danger-light); }
