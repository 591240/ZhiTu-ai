/* settings.wxss —— 设置页（统一高级感设计系统） */
.page { padding: 0 32rpx; min-height: 100vh; background: var(--bg); }

.group {
  background: var(--card);
  border-radius: var(--r-lg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  overflow: hidden;
}
.item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  font-size: 28rpx;
  color: var(--text-1);
  border-bottom: 1rpx solid var(--line);
  transition: background 0.15s;
}
.item:last-child { border-bottom: none; }
.item:active { background: var(--card-soft); }
.arrow { font-size: 32rpx; color: var(--text-4); }
.val { font-size: 24rpx; color: var(--text-3); }

.danger-group {
  background: var(--card);
  border-radius: var(--r-lg);
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  overflow: hidden;
}
.danger-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 30rpx 24rpx;
  font-size: 28rpx;
  color: var(--danger);
  transition: background 0.15s;
}
.danger-item:active { background: var(--danger-light); }

.logout {
  text-align: center;
  padding: 26rpx;
  margin-top: 48rpx;
  font-size: 28rpx;
  color: var(--danger);
  background: var(--card);
  border-radius: var(--r-lg);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.logout:active { background: var(--danger-light); }
