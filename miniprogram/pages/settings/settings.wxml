<view class="page">
  <view class="nav-title">系统设置</view>

  <view class="group">
    <view class="item" bindtap="goMember"><text>会员中心</text><text class="arrow">›</text></view>
    <view class="item" bindtap="goCollection"><text>我的收藏</text><text class="arrow">›</text></view>
    <view class="item" bindtap="goPublished"><text>我的发布</text><text class="arrow">›</text></view>
    <view class="item" bindtap="goChat"><text>随便问助手</text><text class="arrow">›</text></view>
  </view>

  <view class="group">
    <view class="item" bindtap="goAgreement" data-type="privacy"><text>隐私政策</text><text class="arrow">›</text></view>
    <view class="item" bindtap="goAgreement" data-type="user"><text>用户协议</text><text class="arrow">›</text></view>
    <view class="item" bindtap="goFeedback"><text>意见反馈</text><text class="arrow">›</text></view>
    <view class="item"><text>关于知途 AI 旅行</text><text class="val">v{{version}}</text></view>
    <view class="item" bindtap="onClear"><text>清空本地数据</text><text class="arrow">›</text></view>
  </view>

  <view class="danger-group">
    <view class="danger-item" bindtap="onDeactivate"><text>注销账号</text><text class="arrow">›</text></view>
  </view>

  <view class="logout" bindtap="logout">退出登录</view>
</view>
