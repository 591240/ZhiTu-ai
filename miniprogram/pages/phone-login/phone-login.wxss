.pl-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, #EAF1FF 0%, #F5F6FA 40%);
  padding: 0 48rpx;
  box-sizing: border-box;
}
.status-bar { width: 100%; }

.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  position: relative;
}
.nav-back {
  font-size: 48rpx;
  color: #1F2937;
  width: 60rpx;
  line-height: 1;
}
.nav-title {
  position: absolute;
  left: 0; right: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: #1F2937;
}

.pl-header { margin-top: 40rpx; margin-bottom: 56rpx; }
.pl-title { font-size: 44rpx; font-weight: 700; color: #111827; }
.pl-sub { margin-top: 12rpx; font-size: 26rpx; color: #6B7280; }

.field {
  display: flex;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 0 28rpx;
  height: 104rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 6rpx 20rpx rgba(31, 41, 55, 0.04);
}
.prefix {
  font-size: 30rpx;
  color: #374151;
  padding-right: 20rpx;
  margin-right: 20rpx;
  border-right: 1rpx solid #EEE;
}
.input { flex: 1; font-size: 30rpx; color: #111827; }
.code-btn {
  font-size: 26rpx;
  color: #3B82F6;
  font-weight: 600;
  padding-left: 20rpx;
  white-space: nowrap;
}
.code-btn.disabled { color: #9CA3AF; }

.dev-tip {
  font-size: 24rpx;
  color: #D97706;
  background: #FFFBEB;
  border: 1rpx solid #FDE68A;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.btn-primary {
  margin-top: 16rpx;
  background: #3B82F6;
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 20rpx;
  height: 96rpx;
  line-height: 96rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  justify-content: center;
}
.checkbox {
  width: 32rpx; height: 32rpx;
  border-radius: 50%;
  border: 2rpx solid #C4C9D4;
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 12rpx;
}
.checkbox.checked { background: #3B82F6; border-color: #3B82F6; }
.agree-text { font-size: 24rpx; color: #6B7280; }
