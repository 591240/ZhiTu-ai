.pl-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, #F3F3F3 0%, #FFFFFF 40%);
  padding: 0 48rpx;
  box-sizing: border-box;
}
.status-bar { width: 100%; }

.nav-row {
  height: 88rpx;
  display: flex;
  align-items: center;
  position: relative;
}
.nav-back {
  font-size: 48rpx;
  color: var(--text-1);
  width: 60rpx;
  line-height: 1;
}
.nav-title {
  position: absolute;
  left: 0; right: 0;
  text-align: center;
  font-size: 32rpx;
  font-weight: 600;
  color: var(--text-1);
}

.pl-header { margin-top: 40rpx; margin-bottom: 56rpx; }
.pl-title { font-size: 44rpx; font-weight: 700; color: var(--text-1); }
.pl-sub { margin-top: 12rpx; font-size: 26rpx; color: var(--text-3); }

.field {
  display: flex;
  align-items: center;
  background: var(--card-soft);
  border-radius: var(--r-md);
  padding: 24rpx 28rpx;
  margin-bottom: 24rpx;
  border: 1rpx solid var(--border);
}
.prefix {
  font-size: 30rpx;
  color: var(--text-2);
  padding-right: 20rpx;
  margin-right: 20rpx;
  border-right: 1rpx solid var(--line);
}
.input { flex: 1; font-size: 30rpx; color: var(--text-1); }
.code-btn {
  font-size: 26rpx;
  color: var(--primary);
  font-weight: 600;
  padding-left: 20rpx;
  white-space: nowrap;
}
.code-btn.disabled { color: var(--text-4); }

.dev-tip {
  font-size: 24rpx;
  color: var(--amber-text);
  background: var(--bg-amber);
  border: 1rpx solid var(--amber-border);
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  margin-bottom: 24rpx;
}

.agree-row {
  display: flex;
  align-items: center;
  margin-top: 32rpx;
  justify-content: center;
}
.checkbox {
  width: 32rpx; height: 32rpx;
  border-radius: 6rpx;
  border: 2rpx solid var(--text-4);
  color: #fff;
  font-size: 22rpx;
  line-height: 32rpx;
  text-align: center;
  margin-right: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox.checked { background: var(--primary); border-color: var(--primary); }
.agree-text { font-size: 24rpx; color: var(--text-3); }
