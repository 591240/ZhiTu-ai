/* template.wxss —— 模板详情页（统一全局设计系统） */
.page { padding: 0 28rpx 60rpx; min-height: 100vh; background: var(--bg); }

/* 封面：真实图 + emoji 兜底 + 渐变遮罩 */
.cover {
  position: relative;
  margin: 0 -28rpx 24rpx;
  height: 340rpx;
  background: var(--grad-sky);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.cover-emoji { font-size: 130rpx; filter: drop-shadow(0 6rpx 12rpx rgba(0, 0, 0, 0.25)); z-index: 1; }
.cover-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 2; }
.cover-mask {
  position: absolute;
  left: 0; bottom: 0; right: 0;
  height: 180rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.4));
  z-index: 3;
}
.cover-info { position: absolute; left: 32rpx; bottom: 28rpx; color: #fff; z-index: 4; }
.t-title { font-size: 40rpx; font-weight: 700; text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.3); }
.t-meta { font-size: 24rpx; margin-top: 8rpx; opacity: 0.92; }

.tags { display: flex; align-items: center; gap: 14rpx; margin-bottom: 24rpx; flex-wrap: wrap; }

/* 实心标签（蓝底白字），配合全局 .tag 使用 */
.tag-solid {
  background: var(--primary);
  color: #fff;
  border-radius: var(--r-full);
}

.card-title { font-size: 28rpx; font-weight: 600; color: var(--text-1); margin-bottom: 18rpx; }
.day-row { display: flex; align-items: center; padding: 18rpx 0; border-top: 1rpx solid var(--line); }
.day-badge {
  background: var(--primary-light);
  color: var(--primary);
  font-size: 24rpx;
  padding: 10rpx 18rpx;
  border-radius: 12rpx;
}
.day-count { margin-left: 20rpx; font-size: 27rpx; color: var(--text-2); }

.actions { display: flex; gap: 20rpx; margin-top: 40rpx; }
.actions .btn-primary,
.actions .btn-ghost { flex: 1; }

.loading { text-align: center; color: var(--text-3); margin-top: 120rpx; font-size: 28rpx; }
