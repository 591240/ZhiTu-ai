<view class="page">
  <view class="header">
    <view class="title">完善资料</view>
    <view class="sub">绑定手机号，开启智能行程规划</view>
  </view>

  <!-- 头像 -->
  <view class="avatar-section">
    <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
      <image wx:if="{{avatar}}" class="avatar-img" src="{{avatar}}" mode="aspectFill" />
      <view wx:else class="avatar-fallback">
        <image class="avatar-logo" src="/images/logo.png" mode="aspectFit" />
        <view class="avatar-edit">+</view>
      </view>
      <view class="avatar-hint">点击设置头像</view>
    </button>
  </view>

  <!-- 昵称 -->
  <view class="form-card">
    <view class="form-row">
      <text class="form-label">昵称</text>
      <input class="form-input" type="nickname" placeholder="输入或点击获取微信昵称" placeholder-class="ph" value="{{nickname}}" bindblur="onNicknameBlur" />
    </view>
  </view>

  <view class="bind-tip">当前版本暂不支持一键绑定手机号，您可直接用微信登录体验全部功能。</view>

  <view class="skip" bindtap="onSkip">进入小程序</view>
</view>
