.page {
  min-height: 100vh;
  background: #fff;
  padding: 120rpx 60rpx 80rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  text-align: center;
  margin-bottom: 72rpx;
}
.title {
  font-size: 48rpx;
  font-weight: 700;
  color: #111827;
  letter-spacing: 2rpx;
}
.sub {
  font-size: 28rpx;
  color: #6B7280;
  margin-top: 16rpx;
}

/* 头像区域 */
.avatar-section {
  margin-bottom: 80rpx;
}
.avatar-btn {
  width: 220rpx;
  height: 260rpx;
  padding: 0;
  margin: 0;
  background: transparent;
  line-height: normal;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-btn::after { border: none; }

.avatar-img {
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  box-shadow: 0 16rpx 48rpx rgba(59, 130, 246, 0.22);
  background: #fff;
}
.avatar-fallback {
  position: relative;
  width: 200rpx;
  height: 200rpx;
  border-radius: 50%;
  background: #fff;
  border: 4rpx solid #EFF6FF;
  box-shadow: 0 16rpx 48rpx rgba(59, 130, 246, 0.14);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.avatar-logo {
  width: 130rpx;
  height: 130rpx;
}
.avatar-edit {
  position: absolute;
  right: 6rpx;
  bottom: 6rpx;
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #2563EB;
  color: #fff;
  font-size: 32rpx;
  line-height: 48rpx;
  text-align: center;
  box-shadow: 0 4rpx 12rpx rgba(37, 99, 235, 0.3);
}
.avatar-hint {
  margin-top: 20rpx;
  font-size: 24rpx;
  color: #9CA3AF;
}

/* 昵称卡片 */
.form-card {
  width: 100%;
  background: #F9FAFB;
  border-radius: 20rpx;
  padding: 0 32rpx;
  margin-bottom: 64rpx;
  border: 2rpx solid #F3F4F6;
}
.form-row {
  height: 110rpx;
  display: flex;
  align-items: center;
}
.form-label {
  width: 100rpx;
  font-size: 30rpx;
  color: #374151;
  font-weight: 500;
}
.form-input {
  flex: 1;
  height: 110rpx;
  font-size: 30rpx;
  color: #111827;
}
.ph { color: #9CA3AF; }

/* 绑定按钮 */
.bind-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  background: linear-gradient(135deg, #2563EB 0%, #1D4ED8 100%);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 16rpx 40rpx rgba(37, 99, 235, 0.28);
  margin: 0;
  padding: 0;
  line-height: normal;
  letter-spacing: 1rpx;
}
.bind-btn::after { border: none; }

/* 跳过 */
.skip {
  margin-top: 44rpx;
  text-align: center;
  font-size: 26rpx;
  color: #9CA3AF;
}
