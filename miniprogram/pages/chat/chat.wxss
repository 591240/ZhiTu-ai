/* chat.wxss —— 随便问对话页 WF-08（统一高级感设计系统） */
.page { display: flex; flex-direction: column; height: 100vh; background: var(--bg); }

/* 页头 */
.chat-header {
  padding: 32rpx 32rpx 20rpx;
  animation: fadeUp 0.5s ease-out both;
}
.ch-h-title { font-size: 40rpx; font-weight: 800; color: var(--text-1); letter-spacing: -0.5rpx; }
.ch-h-sub { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; }

/* 顶部 Tab：胶囊分段控制器 */
.tabs {
  display: flex;
  margin: 8rpx 32rpx 12rpx;
  padding: 6rpx;
  background: var(--card-soft);
  border-radius: 18rpx;
  box-shadow: inset 0 1rpx 3rpx rgba(0, 0, 0, 0.04);
}
.tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx 0;
  border-radius: 14rpx;
  font-size: 26rpx;
  color: var(--text-2);
  transition: all 0.2s ease;
}
.tab.on {
  background: var(--grad-sky);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-blue);
}

.tab-ico {
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: var(--text-3);
  position: relative;
}
.tab.on .tab-ico { background: #fff; }

/* 随便问图标：小气泡 */
.chat-ico { border-radius: 6rpx; }
.chat-ico::after {
  content: '';
  position: absolute;
  right: -6rpx;
  bottom: 2rpx;
  width: 0;
  height: 0;
  border: 6rpx solid transparent;
  border-left-color: inherit;
}

/* 行李图标：小方块 + 提手 */
.lug-ico { border-radius: 4rpx; }
.lug-ico::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 12rpx;
  height: 8rpx;
  border: 3rpx solid inherit;
  border-bottom: none;
  border-radius: 4rpx 4rpx 0 0;
}

/* 美食图标：小碗 */
.food-ico {
  border-radius: 0 0 14rpx 14rpx;
  height: 22rpx;
  margin-top: 4rpx;
}
.food-ico::after {
  content: '';
  position: absolute;
  top: -8rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 8rpx;
  border: 3rpx solid inherit;
  border-top: none;
  border-radius: 0 0 10rpx 10rpx;
}

/* 对话区 */
.chat-box { flex: 1; padding: 28rpx 24rpx; }

.empty-hint {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 100rpx;
}

/* CSS 机器人头像 */
.robot {
  width: 140rpx;
  height: 140rpx;
  border-radius: var(--r-xl);
  background: linear-gradient(135deg, var(--primary-lighter), var(--primary-light));
  box-shadow: var(--shadow-blue);
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.robot-antenna {
  position: absolute;
  top: -18rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 8rpx;
  height: 22rpx;
  background: var(--primary-light);
  border-radius: 4rpx;
}
.robot-antenna::after {
  content: '';
  position: absolute;
  top: -12rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 18rpx;
  height: 18rpx;
  border-radius: 50%;
  background: var(--orange);
}
.robot-face {
  width: 88rpx;
  height: 72rpx;
  border-radius: 22rpx;
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.06);
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 16rpx;
  position: relative;
}
.robot-eye {
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: var(--primary);
}
.robot-mouth {
  position: absolute;
  bottom: 16rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 26rpx;
  height: 8rpx;
  border-radius: 4rpx;
  background: var(--primary-light);
}

.eh-card {
  margin-top: 28rpx;
  text-align: center;
  padding: 28rpx 48rpx;
  border-radius: 24rpx;
  background: var(--card);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.eh-title {
  font-size: 32rpx;
  font-weight: 700;
  color: var(--text-1);
}
.eh-text {
  font-size: 26rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}

/* 消息气泡 */
.msg-row { display: flex; align-items: flex-start; margin-bottom: 28rpx; }
.msg-row.user { justify-content: flex-end; }
.msg-avatar {
  width: 64rpx;
  height: 64rpx;
  border-radius: 50%;
  margin-right: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: linear-gradient(135deg, var(--primary-lighter), var(--primary-light));
}
.ai-avatar {
  box-shadow: 0 2rpx 8rpx rgba(59, 130, 246, 0.12);
}
.mini-robot {
  width: 36rpx;
  height: 30rpx;
  border-radius: 10rpx;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  position: relative;
}
.mini-robot::after {
  content: '';
  position: absolute;
  top: -6rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 4rpx;
  height: 6rpx;
  background: var(--primary-light);
}
.mini-eye {
  width: 6rpx;
  height: 6rpx;
  border-radius: 50%;
  background: var(--primary);
}

.bubble {
  max-width: 68%;
  padding: 22rpx 26rpx;
  border-radius: 24rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.msg-row.ai .bubble {
  background: #fff;
  color: var(--text-1);
  border-top-left-radius: 8rpx;
  box-shadow: 0 2rpx 12rpx rgba(0, 0, 0, 0.05);
}
.msg-row.user .bubble {
  background: var(--grad-sky);
  color: #fff;
  border-top-right-radius: 8rpx;
  box-shadow: var(--shadow-blue);
}

/* 快捷问题 */
.quick-q {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
  padding: 18rpx 28rpx 8rpx;
}
.q-chip {
  background: var(--card);
  color: var(--text-2);
  font-size: 25rpx;
  padding: 16rpx 24rpx;
  border-radius: 30rpx;
  border: 1rpx solid var(--border);
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.03);
}
.q-chip:active { transform: scale(0.96); background: var(--primary-light); color: var(--primary); border-color: var(--primary-light); }

/* 输入栏：iMessage 风格 */
.input-bar {
  display: flex;
  align-items: flex-end;
  padding: 18rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  background: var(--card);
  border-top: 1rpx solid var(--border);
}
.input-wrap {
  flex: 1;
  background: var(--card-soft);
  border-radius: var(--r-xl);
  padding: 10rpx 12rpx 10rpx 28rpx;
  display: flex;
  align-items: center;
  border: 1rpx solid var(--border);
}
.bar-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--text-1);
  min-height: 64rpx;
  line-height: 44rpx;
  padding: 10rpx 0;
}
.send-btn {
  width: 72rpx;
  height: 72rpx;
  margin-left: 18rpx;
  border-radius: 50%;
  background: var(--primary-light);
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.send-btn.active { background: var(--primary); }
.send-arrow {
  width: 0;
  height: 0;
  margin-left: 6rpx;
  border-top: 14rpx solid transparent;
  border-bottom: 14rpx solid transparent;
  border-left: 22rpx solid #fff;
}

/* 行程微调模式 */
.adjust-head {
  display: flex;
  align-items: center;
  padding: 24rpx 28rpx;
  background: linear-gradient(135deg, var(--primary-light), var(--card));
  border-bottom: 1rpx solid var(--border);
}
.ah-icon {
  width: 72rpx;
  height: 72rpx;
  border-radius: 18rpx;
  background: var(--primary);
  color: #fff;
  font-size: 38rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ah-info { margin-left: 20rpx; }
.ah-title { font-size: 30rpx; font-weight: 600; color: var(--text-1); }
.ah-sub { font-size: 22rpx; color: var(--text-3); margin-top: 6rpx; }

.save-adjust {
  margin: 4rpx 24rpx 0;
  text-align: center;
  padding: 20rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #fff;
  background: linear-gradient(135deg, var(--gold-start), var(--gold-end));
  border-radius: var(--r-full);
  box-shadow: 0 6rpx 18rpx rgba(184, 146, 61, 0.28);
}
.save-adjust:active { transform: scale(0.98); }

/* 行李清单、美食红黑榜 */
.list-box { flex: 1; padding: 24rpx; }
.lug-head {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin: 0 8rpx 20rpx;
}
.lh-ico { font-size: 32rpx; }
.lh-txt { font-size: 26rpx; color: var(--text-3); }

.lug-group {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.lug-group-title { font-size: 28rpx; font-weight: 700; color: var(--text-1); margin-bottom: 12rpx; }
.lug-item {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  font-size: 28rpx;
  color: var(--text-2);
  border-top: 1rpx solid var(--line);
}
.lug-item:first-of-type { border-top: none; }
.check {
  width: 36rpx;
  height: 36rpx;
  border-radius: 10rpx;
  border: 2rpx solid var(--border);
  margin-right: 18rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.2s ease;
}
.check.on {
  background: var(--grad-sky);
  border-color: transparent;
}
.check-tick {
  width: 10rpx;
  height: 18rpx;
  border-right: 3rpx solid #fff;
  border-bottom: 3rpx solid #fff;
  transform: rotate(45deg) translate(-2rpx, -2rpx);
}
.lug-item.done .lug-name { color: var(--text-3); text-decoration: line-through; }

.food-head-row { margin: 0 8rpx 16rpx; }
.fh-pill {
  display: inline-flex;
  align-items: center;
  gap: 10rpx;
  font-size: 28rpx;
  font-weight: 700;
  padding: 10rpx 22rpx;
  border-radius: 30rpx;
}
.fh-pill.red { background: #E8F7F0; color: var(--ok-green); }
.fh-pill.black { background: #FFF0F0; color: var(--danger); }
.fh-dot { width: 12rpx; height: 12rpx; border-radius: 50%; }
.fh-dot.red-dot, .fi-dot.red-dot { background: var(--ok-green); }
.fh-dot.dark-dot, .fi-dot.dark-dot { background: var(--danger); }

.food-card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 26rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.food-item {
  display: flex;
  align-items: center;
  gap: 14rpx;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 14rpx 0;
}
.fi-dot { width: 10rpx; height: 10rpx; border-radius: 50%; flex-shrink: 0; }
