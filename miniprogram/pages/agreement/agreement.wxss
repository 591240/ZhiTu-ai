.page { padding: 0 32rpx; background: var(--bg); min-height: 100vh; }
.content { padding: 32rpx 0; }
.title { font-size: 40rpx; font-weight: bold; color: var(--text-1); margin-bottom: 24rpx; }
.h2 { font-size: 30rpx; font-weight: bold; color: var(--text-1); margin: 32rpx 0 16rpx; }
.p { font-size: 28rpx; color: var(--text-2); line-height: 1.7; margin-bottom: 16rpx; }
