.page { padding: 0; background: var(--bg); min-height: 100vh; }
.tabs {
  display: flex;
  background: #fff;
  border-bottom: 2rpx solid var(--line);
}
.tab {
  flex: 1;
  text-align: center;
  padding: 28rpx 0;
  font-size: 30rpx;
  color: var(--text-2);
  position: relative;
}
.tab.active {
  color: var(--primary);
  font-weight: bold;
}
.tab.active::after {
  content: '';
  position: absolute;
  left: 50%;
  bottom: 0;
  width: 48rpx;
  height: 4rpx;
  background: var(--primary);
  transform: translateX(-50%);
  border-radius: 4rpx;
}
.content { padding: 32rpx; }
.title { font-size: 40rpx; font-weight: bold; color: var(--text-1); margin-bottom: 24rpx; }
.h2 { font-size: 30rpx; font-weight: bold; color: var(--text-1); margin: 32rpx 0 16rpx; }
.p { font-size: 28rpx; color: var(--text-2); line-height: 1.7; margin-bottom: 16rpx; }
