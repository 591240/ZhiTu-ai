/* index.wxss —— 首页（高级感升级） */
@import './icons.wxss';

.page {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  background: linear-gradient(180deg, #F8FAFF 0%, #F6F7F9 400rpx, #F3F4F6 100%);
}

/* ========== 自定义导航栏 ========== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(247, 249, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}
.navbar-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.navbar-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 1rpx;
}

/* ========== 欢迎语 + 城市选择 ========== */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 0 20rpx;
}
.welcome-wrap { flex: 1; }
.welcome-text {
  font-size: 42rpx;
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: -0.5rpx;
  line-height: 1.15;
}
.welcome-sub {
  font-size: 24rpx;
  color: var(--text-3);
  margin-top: 10rpx;
  letter-spacing: 0.5rpx;
}
.city-picker {
  display: flex;
  align-items: center;
  background: rgba(255, 255, 255, 0.85);
  padding: 14rpx 22rpx;
  border-radius: var(--r-full);
  font-size: 25rpx;
  font-weight: 600;
  color: var(--text-1);
  box-shadow: 0 4rpx 16rpx rgba(31, 41, 55, 0.06);
  border: 1rpx solid rgba(228, 232, 240, 0.9);
  backdrop-filter: blur(8rpx);
  transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
}
.city-picker:active,
.city-picker-press { transform: scale(0.96); box-shadow: 0 2rpx 8rpx rgba(31, 41, 55, 0.04); }
.loc-ico { margin-right: 8rpx; opacity: 0.85; }
.arrow { color: var(--text-3); margin-left: 8rpx; font-size: 22rpx; }

/* ========== Hero Banner ========== */
.hero {
  margin-top: 8rpx;
  position: relative;
  background:
    radial-gradient(120% 120% at 80% 20%, rgba(120, 140, 255, 0.55), transparent 55%),
    radial-gradient(80% 80% at 20% 100%, rgba(80, 100, 220, 0.45), transparent 50%),
    linear-gradient(135deg, #2B3A8C 0%, #3F4ECF 40%, #5A67D8 100%);
  color: #fff;
  border-radius: 40rpx;
  padding: 44rpx 40rpx 48rpx;
  overflow: hidden;
  box-shadow: 0 24rpx 56rpx rgba(47, 60, 158, 0.28);
  transition: transform 0.18s ease-out, box-shadow 0.18s ease-out;
}
.hero::before {
  content: '';
  position: absolute;
  inset: 0;
  background-image:
    linear-gradient(rgba(255, 255, 255, 0.06) 1rpx, transparent 1rpx),
    linear-gradient(90deg, rgba(255, 255, 255, 0.06) 1rpx, transparent 1rpx);
  background-size: 40rpx 40rpx;
  mask-image: linear-gradient(135deg, rgba(0,0,0,0.45), transparent 70%);
  -webkit-mask-image: linear-gradient(135deg, rgba(0,0,0,0.45), transparent 70%);
  z-index: 1;
  pointer-events: none;
}
.hero-press { transform: scale(0.97); box-shadow: 0 16rpx 40rpx rgba(47, 60, 158, 0.22); }
.hero-badge {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: rgba(255, 255, 255, 0.95);
  background: rgba(255, 255, 255, 0.14);
  border: 1rpx solid rgba(255, 255, 255, 0.22);
  padding: 10rpx 22rpx;
  border-radius: var(--r-full);
  backdrop-filter: blur(6px);
  position: relative;
  z-index: 2;
}
.hero-badge::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7CF0C8;
  margin-right: 10rpx;
  box-shadow: 0 0 14rpx #7CF0C8;
}
.hero-title {
  font-size: 50rpx;
  font-weight: 800;
  letter-spacing: 0.5rpx;
  position: relative;
  z-index: 2;
  margin-top: 24rpx;
  text-shadow: 0 4rpx 18rpx rgba(0, 0, 0, 0.12);
}
.hero-sub {
  font-size: 26rpx;
  color: rgba(255, 255, 255, 0.78);
  margin-top: 14rpx;
  position: relative;
  z-index: 2;
  font-weight: 400;
}
.hero-decor {
  position: absolute;
  right: -80rpx;
  top: -80rpx;
  width: 360rpx;
  height: 360rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.18) 0%, rgba(255, 255, 255, 0) 65%);
  z-index: 1;
}
.hero-mountains {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 420rpx;
  height: 240rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: bottom right;
  z-index: 1;
}

/* ========== 四大规划入口（统一玻璃卡片） ========== */
.section { margin-top: 44rpx; }
.sec-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-1);
  margin-bottom: 22rpx;
  text-align: left;
  letter-spacing: -0.3rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.grid-item {
  width: calc(50% - 10rpx);
  border-radius: 32rpx;
  padding: 30rpx 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  box-sizing: border-box;
  background: var(--card);
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.05);
  border: 1rpx solid rgba(243, 244, 246, 0.9);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), box-shadow 0.18s ease-out;
}
.grid-item:active,
.gi-press { transform: translateY(-4rpx); box-shadow: 0 12rpx 32rpx rgba(17, 24, 39, 0.08); }

.gi-ico {
  width: 76rpx;
  height: 76rpx;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  position: relative;
  background-color: #F1F5FF;
  border: 1rpx solid rgba(79, 106, 246, 0.10);
  box-shadow: none;
}

.gi-name { font-size: 28rpx; font-weight: 700; color: var(--text-1); letter-spacing: -0.2rpx; }
.gi-desc { font-size: 22rpx; margin-top: 6rpx; color: var(--text-3); line-height: 1.3; }

/* ========== 快捷服务 ========== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 12rpx;
  background: var(--card);
  border-radius: 32rpx;
  padding: 34rpx 18rpx;
  box-shadow: 0 6rpx 24rpx rgba(17, 24, 39, 0.05);
  border: 1rpx solid rgba(243, 244, 246, 0.9);
}
.svc-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.15s ease-out;
}
.svc-press {
  transform: scale(0.92);
  opacity: 0.75;
}
.svc-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 26rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
  box-shadow: none;
  background-color: #F1F5FF;
  border: 1rpx solid rgba(79, 106, 246, 0.10);
}
.svc-name {
  font-size: 22rpx;
  color: var(--text-2);
  font-weight: 500;
}

/* ========== 精选模板 ========== */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sec-head .sec-title { margin-bottom: 0; }
.refresh {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  transition: transform 0.15s ease-out;
}
.refresh:active { transform: scale(0.95); }

.tpl-scroll { white-space: nowrap; }
.tpl-card {
  display: inline-flex;
  flex-direction: column;
  width: 340rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  margin-right: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  vertical-align: top;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tpl-card:active { transform: scale(0.97); }
.tpl-card:last-child { margin-right: 0; }

.tpl-cover {
  width: 340rpx;
  height: 190rpx;
  background: linear-gradient(135deg, #E0E7FF 0%, #C7D2FE 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  position: relative;
  overflow: hidden;
}
.tpl-emoji { filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15)); z-index: 1; }
.tpl-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 2; }
.tpl-badge {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 3;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #FF8A3D, var(--orange));
  padding: 8rpx 20rpx;
  border-bottom-right-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.4);
}

.tpl-info {
  padding: 24rpx;
  width: 340rpx;
  box-sizing: border-box;
}
.tpl-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tpl-meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}
.tpl-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.uses { font-size: 20rpx; color: var(--text-3); }
.tpl-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
  flex-wrap: nowrap;
}
.tpl-tag {
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--r-sm);
  background: var(--primary-lighter);
  color: var(--primary);
}
.tpl-tag.orange { background: #FFF7ED; color: #9A3412; border: 1rpx solid rgba(154, 52, 18, 0.08); }
.tpl-tag.purple { background: #F5F3FF; color: #6D28D9; border: 1rpx solid rgba(109, 40, 217, 0.08); }

/* ========== 动画 ========== */
.fade-enter { animation: fadeIn 0.3s ease-out; }
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.78); }
  to { opacity: 1; transform: scale(1); }
}

.hero { animation: fadeUp 0.5s ease-out both; }
.grid { animation: fadeUp 0.5s ease-out 0.06s both; }
.service-grid { animation: fadeUp 0.5s ease-out 0.12s both; }
.tpl-scroll { animation: fadeUp 0.5s ease-out 0.18s both; }

.svc-item { animation: popIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.svc-item:nth-child(1) { animation-delay: 0.18s; }
.svc-item:nth-child(2) { animation-delay: 0.24s; }
.svc-item:nth-child(3) { animation-delay: 0.30s; }
.svc-item:nth-child(4) { animation-delay: 0.36s; }
.svc-item:nth-child(5) { animation-delay: 0.42s; }
.svc-item:nth-child(6) { animation-delay: 0.48s; }
.svc-item:nth-child(7) { animation-delay: 0.54s; }
.svc-item:nth-child(8) { animation-delay: 0.60s; }

@media (prefers-reduced-motion: reduce) {
  .hero, .grid, .service-grid, .tpl-scroll, .svc-item {
    animation: none;
  }
}
