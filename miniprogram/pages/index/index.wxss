/* index.wxss —— 首页（高级感升级） */
@import './icons.wxss';

.page {
  padding-left: 32rpx;
  padding-right: 32rpx;
  padding-bottom: calc(env(safe-area-inset-bottom) + 120rpx);
  background:
    radial-gradient(120% 90% at 50% 0%, #E8F1FF 0%, rgba(232, 241, 255, 0) 60%),
    linear-gradient(180deg, #F7F9FF 0%, #F9FAFB 400rpx, #F7F8FC 100%);
}

/* ========== 自定义导航栏 ========== */
.custom-navbar {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 1000;
  background: rgba(247, 249, 255, 0.85);
  backdrop-filter: blur(20rpx);
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.04);
  box-sizing: border-box;
}
.navbar-inner {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  position: relative;
}
.navbar-title {
  font-size: 34rpx;
  font-weight: 700;
  color: var(--text-1);
  letter-spacing: 1rpx;
}

/* ========== 欢迎语 + 城市选择 ========== */
.header {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  padding: 24rpx 0 20rpx;
}
.welcome-wrap { flex: 1; }
.welcome-text {
  font-size: 40rpx;
  font-weight: 800;
  color: var(--text-1);
  letter-spacing: -0.5rpx;
}
.welcome-sub {
  font-size: 26rpx;
  color: var(--text-3);
  margin-top: 8rpx;
}
.city-picker {
  display: flex;
  align-items: center;
  background: var(--card);
  padding: 16rpx 24rpx;
  border-radius: var(--r-full);
  font-size: 26rpx;
  color: var(--text-1);
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: transform 0.15s ease-out;
}
.city-picker:active,
.city-picker-press { transform: scale(0.96); }
.loc-ico { margin-right: 8rpx; }
.arrow { color: var(--primary); margin-left: 8rpx; font-size: 24rpx; }

/* ========== Hero Banner ========== */
.hero {
  margin-top: 8rpx;
  position: relative;
  background: var(--grad-blue);
  color: #fff;
  border-radius: 36rpx;
  padding: 40rpx 36rpx 44rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 48rpx rgba(102, 126, 234, 0.35);
  transition: transform 0.18s ease-out;
}
.hero-press { transform: scale(0.97); }
.hero-badge {
  display: inline-flex;
  align-items: center;
  font-size: 22rpx;
  font-weight: 600;
  color: #E0E7FF;
  background: rgba(255, 255, 255, 0.16);
  border: 1rpx solid rgba(255, 255, 255, 0.28);
  padding: 10rpx 20rpx;
  border-radius: var(--r-full);
  backdrop-filter: blur(4px);
  position: relative;
  z-index: 2;
}
.hero-badge::before {
  content: '';
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: #7CF0C8;
  margin-right: 10rpx;
  box-shadow: 0 0 12rpx #7CF0C8;
}
.hero-title {
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 1rpx;
  position: relative;
  z-index: 2;
  margin-top: 20rpx;
}
.hero-sub {
  font-size: 27rpx;
  opacity: 0.88;
  margin-top: 14rpx;
  position: relative;
  z-index: 2;
}
.hero-decor {
  position: absolute;
  right: -60rpx;
  bottom: -70rpx;
  width: 320rpx;
  height: 320rpx;
  border-radius: 50%;
  background: radial-gradient(circle, rgba(255, 255, 255, 0.22), rgba(255, 255, 255, 0) 70%);
  z-index: 1;
}
.hero-mountains {
  position: absolute;
  right: 0;
  bottom: 0;
  width: 360rpx;
  height: 200rpx;
  background-image: url("data:image/svg+xml;base64,");
  background-size: contain;
  background-repeat: no-repeat;
  background-position: bottom right;
  z-index: 1;
}

/* ========== 四大规划入口（统一玻璃卡片） ========== */
.section { margin-top: 40rpx; }
.sec-title {
  font-size: 34rpx;
  font-weight: 800;
  color: var(--text-1);
  margin-bottom: 20rpx;
  text-align: left;
  letter-spacing: -0.5rpx;
}

.grid {
  display: flex;
  flex-wrap: wrap;
  gap: 20rpx;
}
.grid-item {
  width: calc(50% - 10rpx);
  border-radius: var(--r-lg);
  padding: 32rpx;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
  background: var(--card);
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.gi-press { transform: scale(0.96); }

.gi-ico {
  width: 84rpx;
  height: 84rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 18rpx;
  position: relative;
  box-shadow: var(--shadow-sm);
}
.gi-ico::after {
  content: '';
  position: absolute;
  top: 10rpx;
  left: 14rpx;
  width: 34rpx;
  height: 20rpx;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
}

.gi-name { font-size: 28rpx; font-weight: 700; color: var(--text-1); }
.gi-desc { font-size: 22rpx; margin-top: 6rpx; color: var(--text-3); }

/* ========== 快捷服务 ========== */
.service-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 28rpx 12rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 36rpx 20rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
}
.svc-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1), opacity 0.15s ease-out;
}
.svc-press {
  transform: scale(0.92);
  opacity: 0.75;
}
.svc-ico {
  width: 92rpx;
  height: 92rpx;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 12rpx;
  position: relative;
  box-shadow: var(--shadow-sm);
}
.svc-ico::after {
  content: '';
  position: absolute;
  top: 12rpx;
  left: 16rpx;
  width: 36rpx;
  height: 22rpx;
  background: radial-gradient(circle at 35% 30%, rgba(255, 255, 255, 0.55), rgba(255, 255, 255, 0) 70%);
  border-radius: 50%;
  pointer-events: none;
}
.svc-name {
  font-size: 22rpx;
  color: var(--text-2);
}

/* ========== 精选模板 ========== */
.sec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.sec-head .sec-title { margin-bottom: 0; }
.refresh {
  display: flex;
  align-items: center;
  font-size: 26rpx;
  font-weight: 600;
  color: var(--primary);
  transition: transform 0.15s ease-out;
}
.refresh:active { transform: scale(0.95); }

.tpl-scroll { white-space: nowrap; }
.tpl-card {
  display: inline-flex;
  flex-direction: column;
  width: 340rpx;
  background: var(--card);
  border-radius: var(--r-lg);
  margin-right: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.8);
  vertical-align: top;
  transition: transform 0.18s cubic-bezier(0.34, 1.56, 0.64, 1);
}
.tpl-card:active { transform: scale(0.97); }
.tpl-card:last-child { margin-right: 0; }

.tpl-cover {
  width: 340rpx;
  height: 190rpx;
  background: linear-gradient(135deg, #DBEAFE, #93C5FD);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 72rpx;
  position: relative;
  overflow: hidden;
}
.tpl-emoji { filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.15)); z-index: 1; }
.tpl-img { position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 2; }
.tpl-badge {
  position: absolute;
  left: 0;
  top: 0;
  z-index: 3;
  font-size: 20rpx;
  font-weight: 700;
  color: #fff;
  background: linear-gradient(135deg, #FF8A3D, var(--orange));
  padding: 8rpx 20rpx;
  border-bottom-right-radius: 18rpx;
  box-shadow: 0 4rpx 12rpx rgba(255, 107, 53, 0.4);
}

.tpl-info {
  padding: 24rpx;
  width: 340rpx;
  box-sizing: border-box;
}
.tpl-name {
  font-size: 28rpx;
  font-weight: 700;
  color: var(--text-1);
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.tpl-meta {
  font-size: 22rpx;
  color: var(--text-3);
  margin-top: 10rpx;
}
.tpl-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.uses { font-size: 20rpx; color: var(--text-3); }
.tpl-tags {
  display: flex;
  gap: 8rpx;
  margin-top: 14rpx;
  flex-wrap: nowrap;
}
.tpl-tag {
  font-size: 18rpx;
  padding: 6rpx 12rpx;
  border-radius: var(--r-sm);
  background: var(--primary-lighter);
  color: var(--primary);
}
.tpl-tag.orange { background: #FEF3C7; color: #C2410C; }
.tpl-tag.purple { background: #F3E8FF; color: var(--purple); }

/* ========== 动画 ========== */
.fade-enter { animation: fadeIn 0.3s ease-out; }
@keyframes fadeIn {
  from { opacity: 0; }
  to { opacity: 1; }
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(28rpx); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes popIn {
  from { opacity: 0; transform: scale(0.78); }
  to { opacity: 1; transform: scale(1); }
}

.hero { animation: fadeUp 0.5s ease-out both; }
.grid { animation: fadeUp 0.5s ease-out 0.06s both; }
.service-grid { animation: fadeUp 0.5s ease-out 0.12s both; }
.tpl-scroll { animation: fadeUp 0.5s ease-out 0.18s both; }

.svc-item { animation: popIn 0.45s cubic-bezier(0.34, 1.56, 0.64, 1) both; }
.svc-item:nth-child(1) { animation-delay: 0.18s; }
.svc-item:nth-child(2) { animation-delay: 0.24s; }
.svc-item:nth-child(3) { animation-delay: 0.30s; }
.svc-item:nth-child(4) { animation-delay: 0.36s; }
.svc-item:nth-child(5) { animation-delay: 0.42s; }
.svc-item:nth-child(6) { animation-delay: 0.48s; }
.svc-item:nth-child(7) { animation-delay: 0.54s; }
.svc-item:nth-child(8) { animation-delay: 0.60s; }

@media (prefers-reduced-motion: reduce) {
  .hero, .grid, .service-grid, .tpl-scroll, .svc-item {
    animation: none;
  }
}
