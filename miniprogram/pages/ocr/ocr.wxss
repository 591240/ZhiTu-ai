/* ocr.wxss —— 识图 / 识别视频页（统一高级感设计系统） */
.page { padding: 32rpx 28rpx; min-height: 100vh; background: var(--bg); }
.tip { font-size: 26rpx; color: var(--text-3); line-height: 1.6; margin-bottom: 24rpx; }

/* 模式切换 */
.seg {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12rpx;
  background: var(--card);
  border-radius: var(--r-md);
  padding: 10rpx;
  box-shadow: var(--shadow-sm);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.seg-item {
  text-align: center;
  font-size: 28rpx;
  color: var(--text-2);
  padding: 18rpx 0;
  border-radius: var(--r-sm);
  transition: all 0.15s ease-out;
}
.seg-item.on {
  background: var(--grad-sky);
  color: #fff;
  font-weight: 600;
  box-shadow: var(--shadow-blue);
}
.mode-hint { font-size: 24rpx; color: var(--text-3); line-height: 1.6; margin: 18rpx 4rpx 24rpx; }

/* 上传 */
.upload {
  background: var(--card);
  border: 2rpx dashed var(--primary-light);
  border-radius: var(--r-lg);
  padding: 80rpx 0;
  text-align: center;
  transition: transform 0.15s ease-out;
}
.upload:active { transform: scale(0.98); }
.up-emoji { font-size: 80rpx; }
.up-text { font-size: 28rpx; color: var(--primary); margin-top: 16rpx; }

.preview {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 24rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.img { width: 100%; border-radius: var(--r-md); background: #000; }
.preview .primary { margin-top: 24rpx; }

/* 结果卡片 */
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 28rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.result { margin-top: 28rpx; }
.r-title { font-size: 28rpx; font-weight: 600; color: var(--text-1); margin-bottom: 16rpx; }
.r-line { font-size: 28rpx; color: var(--text-1); margin-bottom: 12rpx; }
.r-spots { display: flex; flex-direction: column; gap: 8rpx; margin-bottom: 24rpx; }
.r-spot { font-size: 27rpx; color: var(--text-2); }

.r-place { font-size: 30rpx; font-weight: 600; color: var(--text-1); margin-bottom: 10rpx; }
.r-desc { font-size: 26rpx; color: var(--text-2); line-height: 1.6; margin-bottom: 10rpx; }
.r-conf { font-size: 24rpx; color: var(--primary); margin-bottom: 8rpx; }

/* 推荐景点 */
.spot {
  background: var(--card-soft);
  border-radius: var(--r-md);
  padding: 20rpx;
  margin-bottom: 16rpx;
}
.spot-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 8rpx; }
.spot-name { font-size: 28rpx; font-weight: 600; color: var(--text-1); }
.spot-cat { font-size: 22rpx; color: var(--primary); background: var(--primary-light); padding: 4rpx 14rpx; border-radius: 20rpx; }
.spot-reason { font-size: 25rpx; color: var(--text-2); line-height: 1.6; margin-bottom: 8rpx; }
.spot-meta { font-size: 23rpx; color: var(--text-3); }

/* 主按钮 */
.primary {
  background: var(--grad-sky);
  color: #fff;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: var(--r-full);
  padding: 22rpx 0;
  border: none;
  box-shadow: var(--shadow-blue);
  transition: transform 0.15s ease-out;
}
.primary:active { transform: scale(0.98); }
