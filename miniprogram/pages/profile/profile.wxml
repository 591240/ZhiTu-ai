<view class="page">
  <!-- 个人信息横幅 -->
  <view class="profile-hero anim-up">
    <view class="ph-decor"></view>
    <button class="avatar-btn" open-type="chooseAvatar" bind:chooseavatar="onChooseAvatar">
      <image wx:if="{{user.avatar}}" class="avatar-img" src="{{user.avatar}}" mode="aspectFill" />
      <view wx:else class="avatar-fallback">{{user.nickname ? user.nickname[0] : '游'}}</view>
    </button>
    <view class="u-info">
      <view class="u-name">
        <input class="nickname-input" type="nickname" placeholder="填写昵称" value="{{user.nickname}}" bindblur="onNicknameChange" />
      </view>
      <view class="u-city">📍 {{user.city || '杭州'}}</view>
    </view>
  </view>

  <!-- 数据统计 -->
  <view class="stats glass anim-up d1">
    <view class="stat">
      <view class="stat-num">{{stats.tripCount}}</view>
      <view class="stat-label">累计行程</view>
    </view>
    <view class="divider"></view>
    <view class="stat">
      <view class="stat-num">{{stats.cityCount}}</view>
      <view class="stat-label">解锁城市</view>
    </view>
  </view>

  <!-- 功能菜单 -->
  <view class="menu glass anim-up d2">
    <view class="menu-item" bindtap="goCollection"><text class="mi-ico">🔖</text><text class="mi-name">我的收藏</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goPublished"><text class="mi-ico">📤</text><text class="mi-name">我的发布</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="onShare"><text class="mi-ico">📨</text><text class="mi-name">分享邀请</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="onService"><text class="mi-ico">🎧</text><text class="mi-name">客服</text><text class="mi-arrow">›</text></view>
    <view class="menu-item" bindtap="goSettings"><text class="mi-ico">⚙️</text><text class="mi-name">系统设置</text><text class="mi-arrow">›</text></view>
  </view>

  <view class="version">知途 AI 旅行 V1.0.0</view>
  <view class="safe-bottom"></view>
</view>
