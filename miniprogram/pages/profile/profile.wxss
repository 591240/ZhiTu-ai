/* profile.wxss —— 个人中心页 WF-09（统一高级感设计系统） */
.page { padding: 0 32rpx; }

/* 个人信息横幅 */
.profile-hero {
  position: relative;
  display: flex;
  align-items: center;
  padding: 44rpx 32rpx;
  margin-bottom: 28rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--grad-sky);
  color: #fff;
  box-shadow: var(--shadow-blue);
}
.avatar-btn {
  width: 112rpx;
  height: 112rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: rgba(255, 255, 255, 0.2);
  border: 4rpx solid rgba(255, 255, 255, 0.5);
  line-height: normal;
  overflow: hidden;
  flex-shrink: 0;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.15);
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.25);
  color: #fff;
  font-size: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.u-info { margin-left: 24rpx; flex: 1; min-width: 0; }
.u-name {
  font-size: 38rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  color: #fff;
}
.nickname-input {
  min-width: 160rpx;
  max-width: 360rpx;
  font-size: 38rpx;
  font-weight: 800;
  color: #fff;
  height: 56rpx;
  line-height: 56rpx;
}
.nickname-input::-webkit-input-placeholder { color: rgba(255, 255, 255, 0.7); }
.u-city { font-size: 24rpx; color: rgba(255, 255, 255, 0.9); margin-top: 10rpx; }

/* 数据统计 */
.stats {
  display: flex;
  align-items: center;
  margin-top: 0;
  padding: 36rpx 0;
}
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 46rpx; font-weight: 800; color: var(--primary); }
.stat-label { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; }
.divider { width: 2rpx; height: 60rpx; background: var(--divider); }

/* 功能菜单 */
.menu { margin-top: 24rpx; padding: 8rpx 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
  transition: background 0.15s ease-out;
}
.menu-item:active { background: var(--card-soft); border-radius: var(--r-md); }
.menu-item:last-child { border-bottom: none; }
.mi-ico {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--primary-lighter);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mi-name { flex: 1; font-size: 30rpx; color: var(--text-1); font-weight: 500; }
.mi-arrow { color: var(--text-4); font-size: 36rpx; }

.version {
  text-align: center;
  color: var(--text-4);
  font-size: 22rpx;
  margin-top: 48rpx;
}
