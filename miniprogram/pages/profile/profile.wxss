/* profile.wxss —— 个人中心页 WF-09（统一高级感设计系统） */
.page { padding: 0 32rpx; }

/* 个人信息横幅 */
.profile-hero {
  position: relative;
  display: flex;
  align-items: center;
  padding: 52rpx 36rpx;
  margin: 12rpx 0 28rpx;
  border-radius: var(--r-lg);
  overflow: hidden;
  background: var(--grad-sky);
  color: #fff;
  box-shadow: var(--shadow-blue);
}
.avatar-btn {
  position: relative;
  width: 136rpx;
  height: 136rpx;
  border-radius: 50%;
  padding: 0;
  margin: 0;
  background: var(--card);
  border: 6rpx solid rgba(255, 255, 255, 0.85);
  box-sizing: border-box;
  min-width: 136rpx;
  min-height: 136rpx;
  line-height: 1;
  overflow: hidden;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 32rpx rgba(31, 94, 197, 0.35);
}
.avatar-btn::after { border: none; }
.avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  display: block;
  flex-shrink: 0;
}
.avatar-fallback {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  background: var(--grad-sky);
  color: #fff;
  font-size: 52rpx;
  font-weight: 700;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: inset 0 0 0 2rpx rgba(255,255,255,0.2);
}
.avatar-edit {
  position: absolute;
  right: -4rpx;
  bottom: -4rpx;
  width: 42rpx;
  height: 42rpx;
  border-radius: 50%;
  background: var(--card);
  color: var(--primary);
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15);
  border: 2rpx solid rgba(255,255,255,0.9);
}
.u-info { margin-left: 28rpx; flex: 1; min-width: 0; }
.u-name {
  font-size: 40rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  color: #fff;
}
.nickname-input {
  min-width: 160rpx;
  max-width: 360rpx;
  font-size: 40rpx;
  font-weight: 800;
  color: #fff;
  height: 60rpx;
  line-height: 60rpx;
  caret-color: #fff;
}
.nickname-input::-webkit-input-placeholder { color: rgba(255, 255, 255, 0.65); }
.u-city {
  display: inline-flex;
  align-items: center;
  margin-top: 14rpx;
  padding: 6rpx 18rpx 6rpx 14rpx;
  background: rgba(255, 255, 255, 0.22);
  border-radius: 999rpx;
  font-size: 24rpx;
  color: #fff;
  backdrop-filter: blur(4rpx);
}
.u-city .loc-pin { font-size: 22rpx; margin-right: 6rpx; }
.hero-arrow {
  margin-left: 16rpx;
  font-size: 40rpx;
  color: rgba(255,255,255,0.7);
  font-weight: 300;
}

/* 数据统计 */
.stats {
  display: flex;
  align-items: center;
  margin-top: 0;
  padding: 36rpx 0;
}
.stat { flex: 1; text-align: center; }
.stat-num { font-size: 46rpx; font-weight: 800; color: var(--primary); }
.stat-label { font-size: 24rpx; color: var(--text-3); margin-top: 8rpx; }
.divider { width: 2rpx; height: 60rpx; background: var(--divider); }

/* 功能菜单 */
.menu { margin-top: 24rpx; padding: 8rpx 24rpx; }
.menu-item {
  display: flex;
  align-items: center;
  padding: 30rpx 0;
  border-bottom: 2rpx solid var(--line);
  transition: background 0.15s ease-out;
}
.menu-item:active { background: var(--card-soft); border-radius: var(--r-md); }
.menu-item:last-child { border-bottom: none; }
.mi-ico {
  font-size: 36rpx;
  margin-right: 20rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 16rpx;
  background: var(--primary-lighter);
  display: flex;
  align-items: center;
  justify-content: center;
}
.mi-name { flex: 1; font-size: 30rpx; color: var(--text-1); font-weight: 500; }
.mi-arrow { color: var(--text-4); font-size: 36rpx; }

.version {
  text-align: center;
  color: var(--text-4);
  font-size: 22rpx;
  margin-top: 48rpx;
}
