/* collection.wxss —— 收藏页（统一高级感设计系统） */
.page { padding: 0 28rpx; min-height: 100vh; background: var(--bg); }

.loading { text-align: center; color: var(--text-3); margin-top: 120rpx; font-size: 28rpx; }

.tpl-list { margin-top: 4rpx; }
.tpl {
  display: flex;
  align-items: center;
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 22rpx 24rpx;
  margin-bottom: 20rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  transition: transform 0.15s ease-out;
}
.tpl:active { transform: scale(0.985); }
.tpl-cover {
  width: 120rpx; height: 120rpx;
  border-radius: var(--r-md);
  background: var(--grad-sky);
  display: flex; align-items: center; justify-content: center;
  font-size: 60rpx;
  flex-shrink: 0;
  box-shadow: var(--shadow-blue);
}
.tpl-info { flex: 1; margin-left: 22rpx; min-width: 0; }
.tpl-title { font-size: 30rpx; font-weight: bold; color: var(--text-1); }
.tpl-meta { font-size: 22rpx; color: var(--text-3); margin-top: 8rpx; }
.tpl-arrow { font-size: 40rpx; color: var(--text-4); flex-shrink: 0; margin-left: 8rpx; }
