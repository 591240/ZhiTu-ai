.login-bg {
  min-height: 100vh;
  background: linear-gradient(180deg, var(--primary-lighter), var(--bg));
  display: flex;
  flex-direction: column;
}
.logo-wrap {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.logo {
  width: 160rpx;
  height: 160rpx;
  border-radius: 36rpx;
  background: var(--card);
  box-shadow: var(--shadow-blue);
}
.app-name {
  font-size: 56rpx;
  font-weight: bold;
  margin-top: 32rpx;
  color: var(--text-1);
}
.slogan {
  font-size: 26rpx;
  color: var(--text-2);
  margin-top: 16rpx;
}
.bottom {
  padding: 0 48rpx 60rpx;
}
.wx-btn {
  display: flex;
  align-items: center;
  justify-content: center;
}
.agree-row {
  display: flex;
  align-items: center;
  margin-top: 28rpx;
}
.checkbox {
  width: 32rpx;
  height: 32rpx;
  border: 2rpx solid var(--text-4);
  border-radius: 6rpx;
  margin-right: 12rpx;
  color: #fff;
  font-size: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.checkbox.checked {
  background: var(--wechat-green);
  border-color: var(--wechat-green);
}
.agree-text {
  font-size: 22rpx;
  color: var(--text-3);
}
.switch-tip {
  margin-top: 36rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--primary);
}

/* 微信隐私授权弹窗 */
.privacy-mask {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: flex-end;
  z-index: 100;
}
.privacy-card {
  width: 100%;
  background: var(--card);
  border-radius: 28rpx 28rpx 0 0;
  padding: 40rpx 40rpx 60rpx;
  box-sizing: border-box;
}
.privacy-title {
  font-size: 34rpx;
  font-weight: bold;
  color: var(--text-1);
  text-align: center;
  margin-bottom: 24rpx;
}
.privacy-body {
  font-size: 26rpx;
  line-height: 1.7;
  color: var(--text-2);
}
.privacy-link {
  color: var(--primary);
}
.privacy-refuse {
  margin-top: 24rpx;
  text-align: center;
  font-size: 26rpx;
  color: var(--text-3);
}
