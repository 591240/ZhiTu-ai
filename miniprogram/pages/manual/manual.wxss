/* manual.wxss —— 手动编排页 WF-05（统一高级感设计系统） */
.page { padding: 28rpx; min-height: 100vh; background: var(--bg); }
.card {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 8rpx 28rpx;
  margin-bottom: 24rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.row { display: flex; align-items: center; padding: 26rpx 0; border-bottom: 1rpx solid var(--line); }
.row:last-child { border-bottom: none; }
.label { width: 140rpx; font-size: 28rpx; color: var(--text-2); }
.val { flex: 1; font-size: 28rpx; color: var(--text-1); }

.stepper { display: flex; align-items: center; }
.step {
  width: 56rpx; height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  background: var(--primary-light);
  color: var(--primary);
  border-radius: 50%;
  font-size: 36rpx;
  transition: transform 0.15s ease-out;
}
.step:active { transform: scale(0.9); background: var(--primary-lighter); }
.step-val { width: 70rpx; text-align: center; font-size: 30rpx; }

.day-block {
  background: var(--card);
  border-radius: var(--r-lg);
  padding: 24rpx;
  margin-bottom: 22rpx;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.day-head { font-size: 28rpx; font-weight: 600; color: var(--text-1); margin-bottom: 16rpx; }
.day-head .tip { font-size: 22rpx; color: var(--text-3); font-weight: normal; margin-left: 12rpx; }
.spot-list { position: relative; }
.spot {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
  background: var(--card-soft);
  border-radius: var(--r-md);
  position: relative;
}
.spot.dragging {
  opacity: 0.95;
  box-shadow: var(--shadow-lg);
  background: var(--primary-lighter);
  border: 1rpx solid var(--primary-light);
}
.spot.drop-target {
  border-top: 6rpx dashed var(--primary);
}
.drag-handle {
  color: var(--text-4);
  font-size: 24rpx;
  padding: 0 12rpx;
  letter-spacing: 2rpx;
}
.spot-name {
  flex: 1;
  background: var(--card);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  border: 1rpx solid var(--border);
}
.spot-time {
  width: 160rpx;
  margin-left: 14rpx;
  background: var(--card);
  border-radius: var(--r-md);
  padding: 18rpx 20rpx;
  font-size: 27rpx;
  border: 1rpx solid var(--border);
}
.spot-del { margin-left: 14rpx; color: var(--text-4); font-size: 32rpx; padding: 0 10rpx; }
.placeholder {
  height: 88rpx;
  line-height: 88rpx;
  margin-bottom: 14rpx;
  border: 2rpx dashed var(--primary);
  border-radius: var(--r-md);
  color: var(--primary);
  font-size: 26rpx;
  text-align: center;
  background: rgba(59, 130, 246, 0.06);
}
.add-spot {
  text-align: center;
  color: var(--primary);
  font-size: 27rpx;
  padding: 18rpx 0;
  border: 1rpx dashed var(--primary-light);
  border-radius: var(--r-md);
  transition: transform 0.15s ease-out;
}
.add-spot:active { transform: scale(0.98); background: var(--primary-lighter); }

.primary-btn {
  margin-top: 12rpx;
  background: var(--grad-sky);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 0;
  border: none;
  box-shadow: var(--shadow-blue);
  transition: transform 0.15s ease-out;
}
.primary-btn:active { transform: scale(0.98); }
