/* trips.wxss —— 我的行程列表页 WF-07（统一高级感设计系统） */
.page { padding: 0 28rpx; background: var(--bg); --sk: #E8ECF3; --sk-2: #F2F5F9; }

.list { margin-top: 22rpx; }

/* 加载骨架屏 */
.loading-state { margin-top: 22rpx; }
.skeleton-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
}
.sk-cover {
  height: 200rpx;
  background: linear-gradient(90deg, var(--sk) 25%, var(--sk-2) 50%, var(--sk) 75%);
  background-size: 200% 100%;
  animation: shimmer 1.4s infinite;
}
.sk-body { padding: 22rpx 24rpx 24rpx; }
.sk-line {
  height: 24rpx;
  border-radius: 6rpx;
  background: var(--sk);
  margin-bottom: 16rpx;
  width: 60%;
}
.sk-line.short { width: 36%; }
.sk-line:last-child { width: 28%; margin-bottom: 0; }
@keyframes shimmer {
  0% { background-position: 200% 0; }
  100% { background-position: -200% 0; }
}

.empty-illust {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--primary-lighter), var(--primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
  box-shadow: var(--shadow-blue);
}
.suitcase {
  width: 88rpx;
  height: 70rpx;
  border-radius: 14rpx;
  background: #fff;
  position: relative;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.06);
}
.suitcase::before {
  content: '';
  position: absolute;
  top: -14rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 34rpx;
  height: 18rpx;
  border: 6rpx solid var(--primary-light);
  border-bottom: none;
  border-radius: 12rpx 12rpx 0 0;
}
.suitcase-stripe {
  position: absolute;
  left: 50%;
  top: 0;
  transform: translateX(-50%);
  width: 12rpx;
  height: 100%;
  background: var(--primary-light);
}
.suitcase-tag {
  position: absolute;
  right: -8rpx;
  top: 18rpx;
  width: 22rpx;
  height: 14rpx;
  background: var(--orange);
  border-radius: 4rpx;
  transform: rotate(-12deg);
}
.empty-title { font-size: 34rpx; font-weight: 700; color: var(--text-1); }
.empty-desc { font-size: 26rpx; color: var(--text-3); margin-top: 12rpx; }
.empty-btn { margin-top: 40rpx; width: 60%; align-self: center; }

.trip-card {
  background: var(--card);
  border-radius: var(--r-lg);
  margin-bottom: 24rpx;
  overflow: hidden;
  box-shadow: var(--shadow-md);
  border: 1rpx solid rgba(255, 255, 255, 0.85);
  transition: transform 0.15s ease-out;
}
.trip-card:active { transform: scale(0.985); }

/* 封面条：蓝紫渐变 + 大 emoji + 城市 + 路线徽标 */
.tc-cover {
  position: relative;
  height: 200rpx;
  background: var(--grad-sky);
  display: flex;
  align-items: center;
  justify-content: center;
}
.tc-emoji { font-size: 90rpx; filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.2)); }
.tc-cover-mask {
  position: absolute;
  left: 0; right: 0; bottom: 0;
  height: 120rpx;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.28));
}
.tc-cover-top {
  position: absolute;
  left: 24rpx; right: 24rpx; top: 20rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.tc-city {
  font-size: 26rpx;
  color: #fff;
  font-weight: 600;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

/* 信息区 */
.tc-body { padding: 22rpx 24rpx 24rpx; }
.tc-title { font-size: 32rpx; font-weight: bold; color: var(--text-1); }
.tc-meta { font-size: 24rpx; color: var(--text-3); margin-top: 10rpx; }
.tc-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
}
.tc-budget { font-size: 30rpx; font-weight: bold; color: var(--orange); }
.tc-budget .cur { font-size: 22rpx; margin-right: 2rpx; }
.tc-del {
  position: relative;
  z-index: 2;
  font-size: 24rpx;
  color: var(--danger);
  background: var(--danger-light);
  padding: 10rpx 26rpx;
  border-radius: var(--r-full);
  min-width: 72rpx;
  text-align: center;
}
.tc-del:active { opacity: 0.8; transform: scale(0.95); }
