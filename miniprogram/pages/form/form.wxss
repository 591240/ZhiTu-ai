/* form.wxss —— AI 表单规划页 WF-02（统一高级感设计系统） */
.page { padding: 0 32rpx; }

.form { margin-top: 0; animation: fadeIn 0.4s ease-out both; }
.field { padding: 22rpx 0; border-bottom: 2rpx solid var(--line); }
.field:last-child { border-bottom: none; }

.picker-val {
  background: var(--card-soft);
  border-radius: var(--r-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--text-1);
  min-height: 88rpx;
  line-height: 46rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
  transition: border-color 0.2s ease;
}
.picker-val:active { border-color: var(--primary); }
.city-input {
  width: 100%;
}

.ph { color: var(--text-3); }

.seg { display: flex; gap: 16rpx; }
.seg.wrap { flex-wrap: wrap; }

.remark {
  width: 100%;
  background: var(--card-soft);
  border-radius: var(--r-md);
  padding: 22rpx;
  font-size: 26rpx;
  height: 160rpx;
  line-height: 1.6;
  border: 1rpx solid var(--border);
  transition: border-color 0.2s ease;
}
.remark:focus { border-color: var(--primary); }

.stepper {
  display: inline-flex;
  align-items: center;
  gap: 24rpx;
  background: var(--card-soft);
  border-radius: var(--r-md);
  padding: 8rpx 24rpx;
  border: 1rpx solid var(--border);
}
.step-btn {
  width: 56rpx; height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: var(--card);
  color: var(--primary);
  font-size: 36rpx;
  font-weight: bold;
  border: 2rpx solid var(--primary-light);
  box-shadow: var(--shadow-sm);
}
.step-btn:active { transform: scale(0.92); background: var(--primary-lighter); }
.step-num { font-size: 32rpx; font-weight: bold; color: var(--text-1); min-width: 40rpx; text-align: center; }

.gen-btn { margin-top: 36rpx; }

.budget-row { align-items: stretch; gap: 16rpx; }
.budget-input {
  flex: 1;
  background: var(--card-soft);
  border-radius: var(--r-md);
  padding: 22rpx 26rpx;
  font-size: 28rpx;
  color: var(--text-1);
  text-align: center;
  min-height: 88rpx;
  line-height: 46rpx;
  box-sizing: border-box;
  border: 1rpx solid var(--border);
}
.budget-input:focus { border-color: var(--primary); }
.budget-sep {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: var(--text-3);
  min-width: 32rpx;
}
