<wxs module="fmt">
function inArray(arr, val) {
  if (!arr) return false
  for (var i = 0; i < arr.length; i++) {
    if (arr[i] === val) return true
  }
  return false
}
module.exports = { inArray: inArray }
</wxs>

<view class="page">
  <view class="page-header anim-up">
    <view class="ph-badge">AI 智能规划</view>
    <view class="ph-title">定制专属行程</view>
    <view class="ph-sub">填写偏好，AI 秒出你的路线</view>
    <view class="ph-decor"></view>
  </view>

  <view class="form card anim-up d1">
    <view class="field">
      <view class="f-label">出发城市</view>
      <view class="city-input-wrap">
        <input class="picker-val city-input" placeholder-class="ph" placeholder="请输入出发城市，如上海" value="{{departureCity}}" bindinput="onDeparture" />
        <text class="city-edit-icon">✏️</text>
      </view>
    </view>

    <view class="field">
      <view class="f-label">目的地城市</view>
      <view class="city-input-wrap">
        <input class="picker-val city-input" placeholder-class="ph" placeholder="请输入目的地城市，如杭州" value="{{city}}" bindinput="onCityInput" />
        <text class="city-edit-icon">✏️</text>
      </view>
    </view>

    <view class="field">
      <view class="f-label">出行日期</view>
      <view class="seg">
        <picker mode="date" value="{{startDate}}" bindchange="onStart">
          <view class="picker-val">{{startDate || '出发日期 ▾'}}</view>
        </picker>
        <picker mode="date" value="{{endDate}}" bindchange="onEnd">
          <view class="picker-val">{{endDate || '返程日期 ▾'}}</view>
        </picker>
      </view>
    </view>

    <view class="field">
      <view class="f-label">出行人数</view>
      <view class="seg">
        <view class="stepper">
          <view class="step-btn" data-d="-1" bindtap="setPeople">−</view>
          <text class="step-num">{{peopleCount}}</text>
          <view class="step-btn" data-d="1" bindtap="setPeople">＋</view>
        </view>
      </view>
    </view>

    <view class="field">
      <view class="f-label">出行天数</view>
      <view class="seg-pill">
        <view wx:for="{{[1,2,3,4]}}" wx:key="*this" class="seg-item {{days === item ? 'on' : ''}}" data-d="{{item}}" bindtap="setDays">{{item}}天</view>
      </view>
    </view>

    <view class="field">
      <view class="f-label">出行人群</view>
      <view class="seg wrap">
        <view wx:for="{{CROWD}}" wx:key="*this" class="chip-pill {{crowdIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="setCrowd">{{item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="f-label">预算范围（元/人）</view>
      <view class="seg budget-row">
        <input class="budget-input" type="digit" placeholder-class="ph" placeholder="最低" value="{{budgetMin}}" bindinput="onBudgetMin" />
        <view class="budget-sep">—</view>
        <input class="budget-input" type="digit" placeholder-class="ph" placeholder="最高" value="{{budgetMax}}" bindinput="onBudgetMax" />
      </view>
    </view>

    <view class="field">
      <view class="f-label">游玩偏好（可多选）</view>
      <view class="seg wrap">
        <view wx:for="{{PREFS}}" wx:key="*this" class="chip-pill {{fmt.inArray(prefs, item) ? 'on' : ''}}" data-p="{{item}}" bindtap="togglePref">{{item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="f-label">市内交通方式</view>
      <view class="seg wrap">
        <view wx:for="{{TRANSPORT}}" wx:key="*this" class="chip-pill {{transportIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="setTransport">{{item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="f-label">往返交通偏好</view>
      <view class="seg wrap">
        <view wx:for="{{TRANSPORT_PREF}}" wx:key="*this" class="chip-pill {{transportPrefIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="setTransportPref">{{item}}</view>
      </view>
    </view>

    <view class="field">
      <view class="f-label">路线风格</view>
      <view class="seg-pill">
        <view wx:for="{{ROUTE}}" wx:key="v" class="seg-item {{routeIndex === index ? 'on' : ''}}" data-i="{{index}}" bindtap="setRoute">{{item.label}}</view>
      </view>
    </view>

    <view class="field">
      <view class="f-label">特殊备注</view>
      <textarea class="remark" placeholder="例如：带老人孩子少走路；想吃地道本地菜" value="{{remark}}" bindinput="onRemark" maxlength="200"></textarea>
    </view>
  </view>

  <button class="btn-primary gen-btn anim-up d2" bindtap="onGenerate" loading="{{generating}}">生成行程</button>
  <view class="safe-bottom"></view>
</view>
