/* quick.wxss —— 一句话快规划页 WF-03（统一新色彩规范） */
.page { padding: 32rpx 28rpx 60rpx; min-height: 100vh; background: var(--bg); }

.hero { padding: 24rpx 8rpx 36rpx; text-align: center; }
.hero-emoji { font-size: 72rpx; }
.hero-title { font-size: 38rpx; font-weight: 700; color: var(--text-1); margin-top: 16rpx; }
.hero-sub { font-size: 26rpx; color: var(--text-3); margin-top: 12rpx; }

.card {
  background: var(--card);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 2rpx 12rpx rgba(59, 130, 246, 0.08);
}

.input-card { position: relative; }
.input { width: 100%; min-height: 180rpx; font-size: 30rpx; color: var(--text-1); line-height: 1.6; }
.count { text-align: right; font-size: 22rpx; color: var(--text-4); margin-top: 8rpx; }

.examples { margin-top: 36rpx; }
.sec-title { font-size: 28rpx; font-weight: 600; color: var(--text-1); margin-bottom: 20rpx; }
.chips { display: flex; flex-wrap: wrap; gap: 18rpx; }
.chip { background: var(--primary-light); color: var(--primary); font-size: 26rpx; padding: 16rpx 24rpx; border-radius: 16rpx; }
.chip:active { transform: scale(0.96); }

.parse { margin-top: 36rpx; background: var(--primary-light); border-radius: 16rpx; padding: 24rpx; }
.parse-label { font-size: 24rpx; color: var(--primary); margin-bottom: 14rpx; }
.parse-items { display: flex; flex-wrap: wrap; gap: 16rpx; }
.parse-item { background: var(--card); color: var(--text-1); font-size: 26rpx; padding: 12rpx 22rpx; border-radius: 12rpx; }

.primary-btn {
  margin-top: 48rpx;
  background: linear-gradient(135deg, #60A5FA, #3B82F6);
  color: #fff;
  font-size: 32rpx;
  font-weight: 600;
  border-radius: 48rpx;
  padding: 26rpx 0;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(59, 130, 246, 0.25);
  transition: transform 0.15s ease-out;
}
.primary-btn:active { transform: scale(0.98); }
.primary-btn[disabled] { background: #c8d6e5; box-shadow: none; }
