<view class="page">
  <view class="page-header anim-up">
    <view class="ph-badge">AI 一句话规划</view>
    <view class="ph-title">说出你的旅行</view>
    <view class="ph-sub">用大白话描述，AI 帮你生成完整路线</view>
    <view class="ph-decor"></view>
  </view>

  <view class="card input-card anim-up d1">
    <textarea class="input" placeholder="例如：周末带爸妈去杭州玩2天，想轻松点，多看看自然风景" value="{{text}}" bindinput="onInput" maxlength="200" auto-height />
    <view class="count">{{text.length}}/200</view>
  </view>

  <view class="examples anim-up d2">
    <view class="sec-title">试试这些</view>
    <view class="chips">
      <view class="chip-pill" wx:for="{{examples}}" wx:key="*this" bindtap="onExample" data-text="{{item}}">{{item}}</view>
    </view>
  </view>

  <view class="parse anim-up d3" wx:if="{{parsed}}">
    <view class="parse-label">已识别</view>
    <view class="parse-items">
      <view class="parse-item">📍 {{parsed.city}}</view>
      <view class="parse-item">📅 {{parsed.days}}天</view>
      <view class="parse-item">🧭 {{parsed.routeLabel}}</view>
      <view class="parse-item" wx:if="{{parsed.crowd_type}}">👥 {{parsed.crowd_type}}</view>
    </view>
  </view>

  <button class="btn-primary primary-btn anim-up d4" loading="{{generating}}" bindtap="onGenerate" disabled="{{!text || generating}}">✨ 生成我的行程</button>
</view>
