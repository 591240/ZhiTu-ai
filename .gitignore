*.py[cod]
*.pyc
server/venv/
server/.venv/
.venv/
*.egg-info/
.pytest_cache/
server/.pytest_tmp/
.mypy_cache/
.ruff_cache/

# ===================== Node / 前端 =====================
node_modules/
frontend/node_modules/
frontend/dist/
npm-debug.log*
yarn-error.log*

