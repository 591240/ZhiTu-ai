# =====================================================================
# 知途 AI 旅行 —— 环境变量模板（复制为 .env 后填写）
# cp .env.example .env && chmod 600 .env
# =====================================================================

# ---- 运行环境 ----
# development：CORS 自动放行 localhost 与局域网（192.168/10.x），本机联调用。
# production  ：关闭局域网放行，只认 CORS_ORIGINS 白名单。
# 注：docker-compose 已在 backend 的 environment 里固定 APP_ENV=production，
#     容器化部署不用管这项；只有直接跑 uvicorn 时才需要自己设。
APP_ENV=production

# ---- CORS 白名单（逗号分隔的完整 Origin，含协议与端口）----
# 本项目用户端是微信小程序，wx.request 不走同源策略，这里基本是空转；
# 留着只是为了将来加网页端/管理后台时不再踩 ["*"]。
CORS_ORIGINS=

# ---- 对外可访问的后端基础 URL（头像等静态资源的绝对链接前缀）----
# 小程序 <image> 只认绝对 URL，留空时后端会退化成用请求 Host 推导（经网关即可正确）。
# 建议显式填公网域名：PUBLIC_BASE_URL=https://api.你的域名
PUBLIC_BASE_URL=

# ---- 基础设施 ----
MYSQL_ROOT_PASSWORD=change_this_root_pwd
MYSQL_DATABASE=zhisuibanyou
REDIS_PASSWORD=change_this_redis_pwd

DATABASE_URL=mysql+aiomysql://root:change_this_root_pwd@mysql:3306/zhisuibanyou
REDIS_URL=redis://:change_this_redis_pwd@redis:6379/0

# ---- 应用密钥（务必换成随机值：openssl rand -hex 32）----
JWT_SECRET=replace_with_random_hex_32bytes

# ---- 微信小程序 ----
WX_APP_ID=your_appid
WX_APP_SECRET=your_appsecret

# ---- LLM ----
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_key
LLM_MODEL=deepseek-v4-flash
LLM_THINKING=false

# ---- 视觉模型 ----
VISION_API_KEY=your_qwen_vl_key
VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# ---- 短信 ----
SMS_PROVIDER=chuangxin
CHUANGXIN_APP_CODE=your_appcode
CHUANGXIN_SIGN=创信
LUOSIMAO_KEY=
LUOSIMAO_SIGN=知途旅行

# ---- 微信支付（待填）----
WX_MCH_ID=
WX_API_V3_KEY=

# ---- 地图 ----
TENCENT_LBS_KEY=
GAODE_MCP_URL=
GAODE_GEOCODE_TOOL=geocode
GAODE_WEB_KEY=

# ---- 12306 MCP（留空降级）----
TICKET_MCP_URL=

# ---- 多项目共存端口（服务器 80/3306 已被「高保真项目」占用）----
# gateway 只绑 127.0.0.1，公网入口由宿主机 Nginx 用已备案域名 + 443 反代到这里
GATEWAY_PORT=8081
# MySQL 供 Navicat 走 SSH 隧道访问用，不对公网开放
MYSQL_HOST_PORT=3307
