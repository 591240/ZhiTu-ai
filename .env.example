# =====================================================================
# 知途 AI 旅行 —— 环境变量模板（复制为 .env 后填写）
# cp .env.example .env && chmod 600 .env
# =====================================================================

# ---- 基础设施 ----
MYSQL_ROOT_PASSWORD=change_this_root_pwd
MYSQL_DATABASE=zhisuibanyou
REDIS_PASSWORD=change_this_redis_pwd

DATABASE_URL=mysql+aiomysql://root:change_this_root_pwd@mysql:3306/zhisuibanyou
REDIS_URL=redis://:change_this_redis_pwd@redis:6379/0

# ---- 应用密钥（务必换成随机值：openssl rand -hex 32）----
JWT_SECRET=replace_with_random_hex_32bytes

# ---- 微信小程序 ----
WX_APP_ID=your_appid
WX_APP_SECRET=your_appsecret

# ---- LLM ----
LLM_API_URL=https://api.deepseek.com/v1
LLM_API_KEY=your_deepseek_key
LLM_MODEL=deepseek-v4-flash
LLM_THINKING=false

# ---- 视觉模型 ----
VISION_API_KEY=your_qwen_vl_key
VISION_API_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
VISION_MODEL=qwen-vl-max

# ---- 短信 ----
SMS_PROVIDER=chuangxin
CHUANGXIN_APP_CODE=your_appcode
CHUANGXIN_SIGN=创信
LUOSIMAO_KEY=
LUOSIMAO_SIGN=知途旅行

# ---- 微信支付（待填）----
WX_MCH_ID=
WX_API_V3_KEY=

# ---- 地图 ----
TENCENT_LBS_KEY=
GAODE_MCP_URL=
GAODE_GEOCODE_TOOL=geocode
GAODE_WEB_KEY=

# ---- 12306 MCP（留空降级）----
TICKET_MCP_URL=
