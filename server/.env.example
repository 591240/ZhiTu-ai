# ============ 伴游 后端环境变量配置 ============
# 复制本文件为 .env 并填入真实值后启动服务即可切换真实环境。
# 未填写的字段会自动走 Mock / SQLite 兜底，方便本地无依赖预览。

# ---- 运行环境 ----
APP_ENV=development

# ---- 数据库 ----
# 本地默认（零配置，开箱即用）：
# DATABASE_URL=sqlite+aiosqlite:///./banyou.db
# 接入你的 MySQL（示例，请替换为你自己的连接串）：
# DATABASE_URL=mysql+aiomysql://<用户名>:<密码>@<host>:<端口>/<数据库名>?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./banyou.db

# ---- Redis（限流/缓存，可选；留空则跳过） ----
# 示例：REDIS_URL=redis://:<密码>@<host>:<端口>/0
REDIS_URL=

# ---- 微信小程序（前端登录wx.login后换openid） ----
# 用户已确认有 AppID，待提供。
WX_APP_ID=
WX_APP_SECRET=

# ---- JWT ----
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRE_HOURS=168

# ---- 大模型（行程生成 / 智能问答，用户已确认有 Key，待提供） ----
# 兼容 OpenAI 接口格式（deepseek / 通义 / 智谱 等均可）。
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat

# ---- 每日免费生成次数（会员不限） ----
DAILY_PLAN_LIMIT=3

# ---- OCR（截图识行程，可选，待提供） ----
OCR_API_KEY=
OCR_SECRET_KEY=

# ---- 微信支付（会员订阅闭环，可选，待提供） ----
WX_MCH_ID=
WX_API_V3_KEY=
