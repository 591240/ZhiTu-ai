# ============ 知途 AI 旅行 后端环境变量配置 ============
# 复制本文件为 .env 并填入真实值后启动服务即可切换真实环境。
# 留空的字段会走各自的内置兜底（本地生成器 / 内置坐标表 / 关键词检索），不会启动失败。
# 唯一例外见文件末尾「生产环境硬约束」——那两项在生产态是必须的。

# ---- 运行环境 ----
# development：CORS 自动放行 localhost 与局域网（192.168/10.x），真机联调可直接用局域网 IP。
# production  ：关闭局域网放行，只认 CORS_ORIGINS 白名单，上线前必须切这个值。
APP_ENV=development

# ---- CORS 白名单（逗号分隔的完整 Origin）----
# 小程序原生 wx.request 不走浏览器同源策略，这里只约束 H5 / 网页端 / 后台来源。
# 上线填公网域名，例：CORS_ORIGINS=https://www.example.com,https://admin.example.com
CORS_ORIGINS=

# ---- 数据库 ----
# 本地默认（零配置，开箱即用）：
# DATABASE_URL=sqlite+aiosqlite:///./banyou.db
# 接入你的 MySQL（示例，请替换为你自己的连接串）：
# DATABASE_URL=mysql+aiomysql://<用户名>:<密码>@<host>:<端口>/<数据库名>?charset=utf8mb4
DATABASE_URL=sqlite+aiosqlite:///./banyou.db

# ---- Redis（限流/验证码/短信，可选；留空则退回进程内计数）----
# ⚠️ 进程内计数只适用于单 worker。uvicorn --workers > 1 时必须配 Redis，
#    否则每日限流、验证码、短信频率限制会每个进程各算一份，实际额度翻倍。
# 示例：REDIS_URL=redis://:<密码>@<host>:<端口>/0
REDIS_URL=

# ---- 静态资源对外地址（生成头像永久链接用，可选）----
# 留空则从请求头（X-Forwarded-Host / Host）推导；经网关反代时网关需透传 X-Forwarded-Proto。
# 示例：PUBLIC_BASE_URL=https://api.example.com
PUBLIC_BASE_URL=

# ---- 微信小程序（前端 wx.login 后换 openid） ----
# 未配置时登录接口返回本地 mock openid，仅限本地开发。
WX_APP_ID=
WX_APP_SECRET=

# ---- JWT ----
# ⚠️ 生产环境必须是 ≥32 位随机串。沿用默认值 / 过短时，APP_ENV=production 会直接拒绝启动。
#    生成方式：python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=请替换为随机长字符串
JWT_EXPIRE_HOURS=168

# ---- 大模型（行程生成 / 智能问答 / 对话微调） ----
# 兼容 OpenAI 接口格式（deepseek / 通义 / 智谱 等均可）。
# 未配置 LLM_API_KEY 时自动降级为内置本地生成器（不联网也能出行程，但内容固定）。
LLM_API_URL=https://api.deepseek.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=deepseek-chat
# 思考模式：true 会带上 thinking 字段并限制预算（更慢更贵），false 完全关闭。
LLM_THINKING=false

# ---- Embedding（RAG 向量检索）----
# 留空则复用上面视觉模型那套 url/key（百炼同一个账号即可出 embedding，无需新增凭据）。
# 两个都留空且 VISION_API_KEY 也为空时，检索自动降级为关键词匹配（/api/kb/status 可查）。
EMBEDDING_API_URL=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-v3

# ---- 向量存储（Milvus）----
# 留空 = 向量检索整体关闭，检索退回关键词匹配（/api/kb/status 的 engine 字段可查）。
# ⚠️ 变量名必须带 KB_ 前缀：裸的 MILVUS_URI 是 pymilvus 自己 import 时就读的环境变量，
#    它只接受 http[s]:// 形式，填成本地文件路径会让 pymilvus 导入即抛异常。
# 两种形态同一个变量：
#   本地开发用内嵌引擎，填文件路径（相对后端目录 server/ 解析，与启动目录无关）：
#       KB_MILVUS_URI=kb/corpus/milvus.db
#   容器部署连独立服务，填 gRPC 地址：
#       KB_MILVUS_URI=http://milvus:19530
# 建索引与查询走同一个 URI；milvus-lite 会对数据目录加锁，
# 所以 server 已经起着时，build_kb.py 也必须用 http:// 形式连它，不能直接开文件。
KB_MILVUS_URI=
KB_MILVUS_COLLECTION=kb_docs
# 官方 Milvus 开启鉴权后填 用户名:密码；milvus-lite 留空
KB_MILVUS_TOKEN=

# ---- 每日免费生成次数（会员不限）----
DAILY_PLAN_LIMIT=3

# ---- 变现开关（会员 / 积分 / 分销佣金）----
# false = 个人主体上架：AI 生成与问答不扣积分、不拦截，会员/积分入口在前端隐藏。
# true  = 企业/个体工商户主体：启用积分扣减与会员闭环（需同步配置微信支付商户号）。
# 必须与 miniprogram/config/env.js 的 MONETIZATION_ENABLED 保持一致。
MONETIZATION_ENABLED=false

# ---- 积分（仅 MONETIZATION_ENABLED=true 时生效）----
POINTS_SIGNUP=20        # 注册/首次登录赠送积分
POINTS_PER_PLAN=10      # 每次 AI 生成行程消耗
POINTS_PER_CHAT=2       # 每次 AI 问答消耗（对话微调也按这个扣）

# ---- 视觉多模态（识图 / 识别视频，可选）----
# 支持 OpenAI 兼容协议：通义千问 Qwen-VL、GPT-4o、Gemini 等。
# 获取：阿里云百炼 https://dashscope.console.aliyun.com → 开通 qwen-vl 系列
VISION_API_KEY=
VISION_API_URL=
VISION_MODEL=qwen-vl-max

# ---- OCR（截图识行程，可选；当前实现走上面的视觉模型，这两个字段预留）----
OCR_API_KEY=
OCR_SECRET_KEY=

# ---- 短信服务（手机号验证码登录注册用）----
# provider 可选：aliyun(官方Dysmsapi) / alicloud-market(阿里云市场三网106短信) /
#                chuangxin(阿里云市场创信) / luosimao(螺丝帽)
# ⚠️ 未配置对应 key 时：开发态把验证码回传前端方便调试；
#    生产态（APP_ENV=production）直接报错，绝不静默降级成"谁都能登录任意手机号"。
SMS_PROVIDER=chuangxin
# 阿里云官方短信
SMS_API_KEY=
SMS_API_SECRET=
SMS_SIGN_NAME=
SMS_TEMPLATE_CODE=
# 阿里云市场「三网106短信」（provider=alicloud-market）
SMS_APP_CODE=
SMS_MARKET_URL=https://gyytz.market.alicloudapi.com/sms/smsSend
SMS_MARKET_TEMPLATE_ID=
SMS_MARKET_SIGN_ID=
# 阿里云市场「创信短信」（provider=chuangxin）
CHUANGXIN_APP_CODE=
CHUANGXIN_URL=https://cxkjsms.market.alicloudapi.com/chuangxinsms/dxjk
CHUANGXIN_SIGN=创信
# 螺丝帽（provider=luosimao）
LUOSIMAO_KEY=
LUOSIMAO_SIGN=

# ---- 微信支付（会员订阅闭环，需企业主体 + 商户号）----
WX_MCH_ID=
WX_API_V3_KEY=

# ---- 分销佣金（CPS）----
COMMISSION_RATE=0.30        # 邀请人获得被邀请人付费金额的比例
INVITE_CODE_LEN=6           # 邀请码长度（大写字母+数字）

# ---- 真实票务：本地 12306-mcp（Node 进程）的 MCP endpoint ----
# 启动示例：npx -y 12306-mcp --port 8801  →  endpoint 为 http://127.0.0.1:8801/mcp
# 留空则不调用，search 接口直接返回离线估算兜底。
# 容器内 127.0.0.1 不可达宿主机服务，docker-compose 已显式置空。
TICKET_MCP_URL=http://127.0.0.1:8801/mcp

# ---- 地理位置服务（景点坐标 / 天气 / 公交路径 / POI 候选池）----
# 腾讯位置服务 WebService key（地理编码优先级最高）
TENCENT_LBS_KEY=
# 高德地图 MCP（站点/地名 → 经纬度）
GAODE_MCP_URL=
GAODE_GEOCODE_TOOL=geocode
# 高德开放平台 Web 服务 Key（REST 直连，天气 + POI 都走它；不配则全部走内置兜底）
GAODE_WEB_KEY=

# ============ 生产环境硬约束 ============
# 1. JWT_SECRET 必须 ≥32 位随机串，否则 APP_ENV=production 拒绝启动。
# 2. APP_ENV=production 时若短信服务未配置，/api/sms/send 会直接报错而不是回传验证码。
# 3. MONETIZATION_ENABLED=true 时必须同时配置微信支付商户号（WX_MCH_ID / WX_API_V3_KEY）。
# 4. 多 worker 部署必须配置 REDIS_URL，否则限流/验证码/短信频率限制失效。
